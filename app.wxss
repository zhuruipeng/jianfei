@import "./styles/ui-tokens.wxss";

/* 全局样式 */
page {
  background: #F7F8FA;
  color: #1F2937;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 32rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input {
  box-sizing: border-box;
}

button::after {
  border: none;
}

/* 通用大字体规范 */
.text-xl {
  font-size: 44rpx;
  font-weight: 700;
}

.text-lg {
  font-size: 36rpx;
  font-weight: 600;
}

.text-md {
  font-size: 32rpx;
  font-weight: 500;
}

.text-sm {
  font-size: 28rpx;
  font-weight: 400;
}

.text-xs {
  font-size: 24rpx;
  font-weight: 400;
}

.color-primary {
  color: #4ECDC4;
}

.color-accent {
  color: #FF6B6B;
}

.color-muted {
  color: #8A93A5;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 41, 55, 0.04);
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
