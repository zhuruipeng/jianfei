# 轻一点 analyzeMeal 云函数环境变量示例（V7 AI 饮食分析 V1）
# ⚠️ 使用方法：
#   1) 复制本文件为 .env 或在微信云函数控制台/Serverless 平台里配置环境变量
#   2) 把真实密钥填入，不要把真实 .env 提交 Git
#   3) 密钥永远只保存在服务端，不要出现在小程序前端代码 / Storage / 云函数返回值中

# AI API Key（Bearer Token）。任何厂商的 OpenAI-compatible Key 都可以。
AI_API_KEY=

# API Base URL（不要以 / 结尾）。不同厂商示例：
#   OpenAI:           https://api.openai.com
#   通义千问 DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
#   字节豆包 Volc:    https://ark.cn-beijing.volces.com/api/v3
AI_BASE_URL=

# 模型名（视觉模型）。推荐：
#   OpenAI:       gpt-4o-mini
#   通义:         qwen-vl-max  或 qwen2.5-vl-72b-instruct（根据可用兼容模型）
#   豆包:         根据控制台实际视觉模型名填写
AI_MODEL=
