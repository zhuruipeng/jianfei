/* pages/journey/journey.wxss - V12 旅程地图 */
.page {
  min-height: 100vh;
  background: #F3FBFB;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.hero {
  padding: 16rpx 8rpx 28rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2937;
}
.hero-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #8A93A5;
}

.stops-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 8rpx;
  box-shadow: 0 6rpx 24rpx rgba(46, 179, 169, 0.06);
}

.stop-row {
  display: flex;
  align-items: flex-start;
}
.stop-anchor {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  border: 4rpx solid transparent;
}
.stop-reached {
  background: #4ECDC4;
  color: #FFFFFF;
}
.stop-future {
  background: #F7F8FA;
  color: #C6CDD8;
}
.stop-current {
  border-color: #A8E8E2;
  background: #FFFFFF;
  color: #4ECDC4;
  transform: scale(1.12);
}
.stop-icon-done {
  font-size: 28rpx;
}
.stop-icon-dot {
  font-size: 32rpx;
}

.stop-body {
  margin-left: 24rpx;
  flex: 1;
  padding-bottom: 20rpx;
}
.stop-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.stop-day {
  font-size: 26rpx;
  color: #8A93A5;
  font-weight: 500;
}
.stop-date {
  font-size: 24rpx;
}
.stop-name {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 700;
}
.stop-name-on {
  color: #1F2937;
}
.stop-name-off {
  color: #B7BFCE;
}
.stop-current-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #E7FAF8;
  color: #22B3AA;
  font-size: 22rpx;
  font-weight: 600;
}

.stop-connector {
  width: 4rpx;
  height: 72rpx;
  margin-left: 26rpx;
  margin-top: -12rpx;
  margin-bottom: 4rpx;
  border-radius: 4rpx;
  background: #EEF0F4;
}
.stop-connector.conn-reached { background: #B7E8E2; }
.stop-connector.conn-future { background: #EEF0F4; }

.tip-card {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  background: #FFF8E8;
  color: #7A6B35;
  font-size: 26rpx;
  line-height: 1.6;
  border-radius: 20rpx;
}

.bottom-space { height: 80rpx; }

.muted { color: #8A93A5; }

/* V12.1：旅程页补充（back + 旅程卡网格 + 详情） */
.hero {
  position: relative;
}
.back-btn {
  position: absolute;
  left: 0;
  top: 18rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  color: #4E5B70;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  line-height: 1;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.back-btn-hover { background: #E9FAF7; }

/* 旅程卡 Section */
.jc-section {
  margin-top: 36rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 28rpx 18rpx;
  box-shadow: 0 6rpx 24rpx rgba(46, 179, 169, 0.05);
}
.jc-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 6rpx 18rpx;
}
.jc-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}
.jc-count {
  font-size: 24rpx;
  color: #8A93A5;
}

.jc-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.jc-card {
  width: calc((100% - 20rpx) / 2);
  border-radius: 22rpx;
  overflow: hidden;
  background: #F7F8FA;
  transition: transform 0.2s ease;
}
.jc-card-hover { transform: scale(0.98); }

.jc-cover {
  position: relative;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.jc-cover-on {
  background: linear-gradient(160deg, #F1FBFA 0%, #FDF8EE 100%);
}
.jc-cover-off {
  background: #F0F2F6;
}
.jc-cover-img {
  width: 260rpx;
  height: 200rpx;
}
.jc-cover-emoji { line-height: 1; }
.jc-cover-emoji.on  { font-size: 140rpx; }
.jc-cover-emoji.off { font-size: 120rpx; color: #C6CDD8; opacity: 0.55; }

/* 未解锁遮罩：轮廓 + ? */
.jc-cover-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(240, 242, 246, 0.72);
}
.jc-q {
  font-size: 92rpx;
  font-weight: 800;
  color: #B7BFCE;
  line-height: 1;
  text-shadow: 0 0 0 rgba(0,0,0,0);
}

.jc-foot {
  padding: 14rpx 18rpx 18rpx;
}
.jc-foot-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}
.jc-foot-text.on  { color: #2B3544; }
.jc-foot-text.off { color: #A1AABE; }

/* 旅程卡详情 */
.jc-detail-card { padding: 38rpx 32rpx 32rpx; }
.jc-d-head {
  text-align: center;
}
.jc-d-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1F2937;
}
.jc-d-day {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A93A5;
  background: #F3FBFB;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}
.jc-d-cover {
  margin-top: 22rpx;
  background: linear-gradient(160deg, #F1FBFA 0%, #FDF8EE 100%);
  border-radius: 22rpx;
  min-height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  box-sizing: border-box;
}
.jc-d-img {
  width: 100%;
  max-width: 480rpx;
  border-radius: 16rpx;
}
.jc-d-emoji {
  font-size: 200rpx;
  line-height: 1;
}
.jc-d-desc {
  margin-top: 24rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #2B3544;
  text-align: center;
  font-weight: 600;
}
.jc-d-extra {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #6B7388;
  text-align: center;
}
.jc-d-unlocked {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #8A93A5;
  text-align: center;
}
