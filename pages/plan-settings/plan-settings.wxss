/* pages/plan-settings/plan-settings.wxss  V10 计划设置页 */
.pst {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 40rpx) 32rpx;
}
.muted { color: #8A93A5; }

/* ============ Hero ============ */
.hero {
  padding: 56rpx 8rpx 32rpx 8rpx;
}
.brand {
  font-size: 32rpx;
  color: #FF6B6B;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.title {
  margin-top: 16rpx;
  font-size: 44rpx;
  line-height: 1.35;
  color: #1F2937;
  font-weight: 800;
}
.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

/* ============ Section ============ */
.section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(31, 41, 55, 0.04);
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 20rpx;
}
.danger-section { background: #FFFFFF; }
.danger-title { color: #8A93A5; font-weight: 600; }

/* ============ pill ============ */
.opt-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.pill {
  flex: 1 1 calc(33.33% - 16rpx);
  min-width: 140rpx;
  background: #F7F8FA;
  border: 2rpx solid #E7EAF1;
  border-radius: 20rpx;
  padding: 22rpx 16rpx;
  text-align: center;
  transition: transform .1s, border-color .2s, background .2s;
}
.pill-sm {
  flex: 1 1 calc(25% - 16rpx);
  min-width: 120rpx;
  padding: 20rpx 8rpx;
}
.pill-hover { transform: scale(0.98); }
.pill-on {
  border-color: #FF6B6B;
  background: rgba(255, 107, 107, 0.06);
}
.pill-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.2;
}
.pill-on .pill-main { color: #FF6B6B; }

/* ============ 提示文案 ============ */
.hint {
  margin-top: 20rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

/* ============ 保存条 ============ */
.save-bar { margin-top: 32rpx; }
.btn-primary {
  height: 84rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4ECDC4 0%, #FF6B6B 100%);
  color: #FFFFFF;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 107, 0.18);
}
.btn-primary-hover { opacity: .92; }

/* ============ 操作行 ============ */
.action-row {
  display: flex;
  align-items: center;
  padding: 22rpx 8rpx;
  border-radius: 16rpx;
  transition: background .15s;
}
.action-row-hover { background: #F7F8FA; }
.action-row + .action-row { border-top: 1rpx solid rgba(138, 147, 165, 0.10); }
.action-main { flex: 1; min-width: 0; }
.action-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}
.action-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
}
.action-arrow {
  font-size: 36rpx;
  color: #B9C0CD;
  line-height: 1;
}

/* ============ 错误提示 ============ */
.err-msg {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  background: rgba(255, 107, 107, 0.08);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #FF6B6B;
  text-align: center;
}

/* ============ 空 plan 状态 ============ */
.empty-hero {
  padding: 160rpx 48rpx 60rpx 48rpx;
  text-align: center;
}
.empty-hero .brand {
  font-size: 32rpx;
  color: #FF6B6B;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.empty-title {
  margin-top: 32rpx;
  font-size: 40rpx;
  color: #1F2937;
  font-weight: 700;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
}
.empty-hero .btn-primary { margin-top: 64rpx; }
