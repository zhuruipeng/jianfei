<!-- pages/progress/progress.wxml 进展页 -->
<view class="page">

  <!-- 头部：无体重时空态 + 有体重时温和展示（不作为首页最大数字） -->
  <view class="hero card">
    <block wx:if="{{stats.currentWeight === null}}">
      <view class="hero-top">我的进展</view>
      <view class="empty-inner empty-hero">
        <view class="empty-emoji">⚖️</view>
        <view class="empty-title">还没有体重记录</view>
        <view class="empty-desc">第一次记录以后，这里会慢慢出现你的变化趋势。</view>
        <view
          class="btn-primary small"
          bindtap="onClickRecordToday"
          hover-class="btn-primary-hover"
        >
          <text class="btn-icon">⚖</text>
          <text>记录体重</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="hero-top">我的进展</view>
      <view class="hero-label">当前体重</view>
      <view class="hero-current">
        <text class="hero-num">{{stats.currentWeight}}</text>
        <text class="hero-unit">kg</text>
      </view>
      <view class="hero-tip">{{gentleMessage}}</view>
    </block>
  </view>

  <!-- 关键数据卡 -->
  <view class="stats-grid card">
    <view class="stat-col">
      <text class="stat-label">初始体重</text>
      <text class="stat-num">{{stats.initialWeight === null ? '--' : stats.initialWeight}}</text>
      <text class="stat-unit" wx:if="{{stats.initialWeight !== null}}">kg</text>
    </view>
    <view class="stat-col-divider"></view>
    <view class="stat-col">
      <text class="stat-label">当前体重</text>
      <text class="stat-num">{{stats.currentWeight === null ? '--' : stats.currentWeight}}</text>
      <text class="stat-unit" wx:if="{{stats.currentWeight !== null}}">kg</text>
    </view>
    <view class="stat-col-divider"></view>
    <view class="stat-col">
      <text class="stat-label">已变化</text>
      <text class="stat-num change-{{changeClass}}">{{stats.changeText || '--'}}</text>
    </view>
  </view>

  <!-- 记录按钮（没数据/鼓励每天继续） -->
  <view class="row-record">
    <view class="btn-primary full" bindtap="onClickRecordToday" hover-class="btn-primary-hover">
      <text class="btn-icon">⚖</text>
      <text>记录今天的体重</text>
    </view>
  </view>

  <!-- 趋势图 -->
  <view class="section card trend-card">
    <view class="section-head">
      <text class="section-title">最近 30 天体重趋势</text>
      <text class="section-desc muted">共 {{trendPoints.length}} 条记录</text>
    </view>

    <block wx:if="{{trendPoints.length > 0}}">
      <!-- 左侧刻度（3 行） -->
      <view class="canvas-wrap">
        <view class="y-axis">
          <text class="y-tick">{{yTicks.max}} kg</text>
          <text class="y-tick">{{yTicks.mid}} kg</text>
          <text class="y-tick">{{yTicks.min}} kg</text>
        </view>
        <canvas
          canvas-id="weightTrend"
          class="weight-canvas"
          style="{{'width:' + canvasWidth + 'px; height:' + canvasHeight + 'px'}}"
          disable-scroll="true"
        ></canvas>
      </view>
      <!-- X 轴两端日期 -->
      <view class="x-axis">
        <text class="x-tick">{{xTicks.first}}</text>
        <text class="x-tick">{{xTicks.last}}</text>
      </view>
    </block>

    <block wx:else>
      <view class="empty-inner">
        <view class="empty-emoji">⚖️</view>
        <view class="empty-title">还没有体重记录</view>
        <view class="empty-desc">第一次记录以后，这里会慢慢出现你的变化趋势。</view>
        <view
          class="btn-primary small"
          bindtap="onClickRecordToday"
          hover-class="btn-primary-hover"
        >
          <text>记录体重</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 最近记录列表 -->
  <view class="section">
    <view class="section-title-only">
      <text class="section-title">最近记录</text>
    </view>

    <block wx:if="{{recentRecords.length > 0}}">
      <view class="card record-list">
        <view
          class="record-row {{index !== recentRecords.length - 1 ? 'record-row-border' : ''}}"
          wx:for="{{recentRecords}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-datecn="{{item.dateCN}}"
          data-weight="{{item.weight}}"
          bindtap="onClickRecordRow"
          hover-class="record-row-hover"
        >
          <text class="record-date">{{item.dateCN}}</text>
          <view class="record-right">
            <text class="record-weight">{{item.weight}} kg</text>
            <text class="record-arrow muted">›</text>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="card empty-inner small">
        <view class="empty-emoji small">🟟</view>
        <view class="empty-title small">暂无最近记录</view>
        <view class="empty-desc small">记录一次体重以后，这里会按时间倒序显示最近的记录。</view>
      </view>
    </block>
  </view>

  <!-- 反馈入口（所有环境都显示，不局限 develop） -->
  <view class="row-feedback card">
    <view class="btn-secondary full" bindtap="onClickOpenFeedback" hover-class="btn-secondary-hover">
      <text class="btn-icon">🟟</text>
      <text>给轻一点提个建议</text>
    </view>
  </view>

  <view class="bottom-space"></view>

  <!-- V11：自定义体重输入弹窗 -->
  <view wx:if="{{showWeightModal}}" class="modal-mask" catchtap="onWeightModalCancel">
    <view class="modal-card" catchtap="stopPropagation">
      <view class="modal-title">记录今天的体重</view>
      <view class="modal-hint">
        <text wx:if="{{weightModalCurrent !== null}}">当前 {{weightModalCurrent}} kg · </text>
        <text>直接输入新值即可</text>
      </view>
      <view class="modal-input-wrap">
        <input
          class="modal-input"
          type="digit"
          placeholder="如 72.6"
          value="{{weightModalValue}}"
          focus="{{showWeightModal}}"
          confirm-type="done"
          bindinput="onWeightModalInput"
          bindconfirm="onWeightModalSave"
        />
        <text class="modal-unit">kg</text>
      </view>
      <view class="modal-actions">
        <view class="modal-btn modal-btn-cancel" bindtap="onWeightModalCancel">
          <text>取消</text>
        </view>
        <view class="modal-btn modal-btn-confirm" bindtap="onWeightModalSave">
          <text>保存</text>
        </view>
      </view>
    </view>
  </view>
</view>
