.page { padding: 28rpx 28rpx 170rpx; color: #344437; }
.journey-hero, .body-card, .trend-card, .record-card { border: 1rpx solid rgba(115,139,101,.1); box-shadow: 0 10rpx 30rpx rgba(88,105,78,.08); }
.journey-hero { position: relative; overflow: hidden; padding: 38rpx 34rpx 34rpx; border-radius: 32rpx; background: linear-gradient(145deg,#fffdf6 0%,#eef5e8 100%); }
.hero-decor { position: absolute; color: rgba(114,151,94,.15); pointer-events: none; }
.hero-leaf { right: 28rpx; top: 10rpx; font-size: 100rpx; transform: rotate(-18deg); }
.hero-path { right: 36rpx; bottom: 18rpx; font-size: 74rpx; letter-spacing: 7rpx; color: rgba(161,127,91,.14); transform: rotate(-16deg); }
.eyebrow { color: #789066; font-size: 23rpx; font-weight: 600; letter-spacing: 2rpx; }
.hero-title { margin-top: 10rpx; color: #344437; font-size: 38rpx; line-height: 1.35; font-weight: 700; }
.hero-period { margin-top: 7rpx; color: #8b9888; font-size: 23rpx; }
.hero-focus { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 30rpx; padding: 24rpx 26rpx; border-radius: 24rpx; background: rgba(255,255,250,.74); }
.focus-label { color: #768575; font-size: 24rpx; }
.focus-value { margin-top: 2rpx; color: #456044; font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.focus-total { color: #859282; font-size: 24rpx; font-weight: 500; }
.week-dots { display: flex; gap: 9rpx; padding-bottom: 8rpx; }
.week-dot { width: 15rpx; height: 15rpx; border-radius: 50%; background: #dce5d7; }
.week-dot.is-filled { background: #7fa36a; box-shadow: 0 2rpx 5rpx rgba(89,125,71,.2); }
.hero-message { position: relative; z-index: 1; margin-top: 22rpx; color: #667463; font-size: 26rpx; line-height: 1.65; }
.companion-name { color: #8b6e55; font-weight: 600; }
.week-empty { padding: 32rpx 6rpx 10rpx; text-align: center; }
.empty-sprout { font-size: 50rpx; }
.empty-title { margin-top: 8rpx; color: #455545; font-size: 29rpx; font-weight: 600; }
.empty-title.small { font-size: 28rpx; }
.empty-desc { margin-top: 10rpx; color: #8c988a; font-size: 24rpx; line-height: 1.65; }
.section { margin-top: 30rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: center; padding: 0 6rpx 18rpx; }
.section-heading.compact { padding: 0 0 22rpx; }
.section-title { color: #344437; font-size: 31rpx; font-weight: 700; }
.section-subtitle { margin-top: 3rpx; color: #909b8e; font-size: 23rpx; line-height: 1.5; }
.section-mark, .trend-leaf { color: #b89a70; font-size: 34rpx; }
.growth-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.growth-card { min-height: 130rpx; padding: 22rpx; border-radius: 25rpx; display: flex; align-items: center; border: 1rpx solid rgba(90,110,80,.07); }
.tone-leaf { background: #edf5e9; } .tone-wood { background: #f6efe4; } .tone-water { background: #eaf4f3; } .tone-sun { background: #fbf5df; }
.growth-icon { width: 54rpx; height: 54rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.6); font-size: 28rpx; }
.growth-copy { display: flex; flex-direction: column; margin-left: 16rpx; }
.growth-label { color: #71806f; font-size: 23rpx; }
.growth-value { margin-top: 4rpx; color: #3f5241; font-size: 31rpx; font-weight: 700; }
.body-card, .trend-card { padding: 28rpx; border-radius: 30rpx; background: #fffdf8; }
.weight-stats { display: flex; align-items: stretch; padding: 8rpx 0 24rpx; }
.weight-stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.weight-divider { width: 1rpx; margin: 7rpx 0; background: #e7eadf; }
.weight-label { color: #929c90; font-size: 23rpx; }
.weight-value { margin-top: 8rpx; color: #4a594b; font-size: 32rpx; font-weight: 650; }
.weight-unit { margin-left: 4rpx; color: #889587; font-size: 20rpx; font-weight: 400; }
.change-value { color: #6e7e6b; font-size: 29rpx; }
.weight-empty { display: flex; align-items: center; margin: 2rpx 0 24rpx; padding: 20rpx; border-radius: 22rpx; background: #f6f4ec; }
.weight-empty-icon { margin-right: 18rpx; font-size: 36rpx; }
.weight-empty-title { color: #526052; font-size: 27rpx; font-weight: 600; }
.weight-empty-desc { margin-top: 3rpx; color: #909a8e; font-size: 22rpx; }
.weight-button { height: 82rpx; margin: 4rpx 0 0; padding: 0; border-radius: 999rpx; background: #7fa36a; color: #fffdf7; font-size: 28rpx; font-weight: 600; line-height: 82rpx; box-shadow: 0 7rpx 18rpx rgba(98,132,78,.16); }
.weight-button-hover { opacity: .9; transform: scale(.995); }
.button-icon { margin-right: 10rpx; }
.canvas-wrap { display: flex; align-items: stretch; margin-top: 4rpx; }
.y-axis { width: 92rpx; padding: 5rpx 14rpx 9rpx 0; display: flex; flex-direction: column; justify-content: space-between; color: #98a394; font-size: 20rpx; text-align: right; }
.weight-canvas { flex: 1; min-height: 280rpx; border-radius: 18rpx; background: #f7f8f2; }
.x-axis { display: flex; justify-content: space-between; margin: 9rpx 3rpx 0 92rpx; color: #98a394; font-size: 20rpx; }
.trend-note { display: flex; align-items: center; margin-top: 20rpx; padding: 16rpx 18rpx; border-radius: 17rpx; background: #f0f4eb; color: #6f7d6c; font-size: 23rpx; }
.trend-note-dot { width: 10rpx; height: 10rpx; margin-right: 12rpx; border-radius: 50%; background: #86a871; }
.trend-empty { padding: 28rpx 0 16rpx; text-align: center; }
.empty-curve { color: #9db08f; font-size: 60rpx; line-height: 1; }
.record-card { overflow: hidden; padding: 4rpx 24rpx; border-radius: 28rpx; background: #fffdf8; }
.record-row { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; }
.record-row.with-line { border-bottom: 1rpx solid #eceee6; }
.record-row-hover { opacity: .7; }
.record-date { display: flex; align-items: center; color: #586658; font-size: 26rpx; }
.timeline-dot { width: 11rpx; height: 11rpx; margin-right: 15rpx; border: 4rpx solid #d8e3d2; border-radius: 50%; background: #87a972; }
.record-right { display: flex; align-items: center; }
.record-weight { color: #465547; font-size: 29rpx; font-weight: 600; }
.record-arrow { margin-left: 16rpx; color: #a4aea1; font-size: 40rpx; }
.record-empty { display: flex; align-items: center; padding: 27rpx; border-radius: 25rpx; background: #f5f3eb; color: #8d978b; font-size: 23rpx; }
.record-empty-icon { margin-right: 13rpx; color: #8da77c; font-size: 30rpx; }
.feedback-link { margin: 28rpx auto 0; padding: 0 20rpx; background: transparent; color: #879483; font-size: 24rpx; line-height: 60rpx; }
.feedback-link-hover { color: #647a5e; }
.bottom-space { height: 60rpx; }
.modal-mask { position: fixed; inset: 0; z-index: 999; display: flex; align-items: center; justify-content: center; background: rgba(42,50,42,.4); }
.modal-card { width: 580rpx; padding: 44rpx 38rpx 32rpx; border-radius: 30rpx; background: #fffdf8; box-shadow: 0 20rpx 55rpx rgba(40,50,38,.18); }
.modal-title { color: #3f4f41; font-size: 34rpx; font-weight: 700; text-align: center; }
.modal-hint { margin-top: 12rpx; color: #8b9689; font-size: 24rpx; text-align: center; }
.modal-input-wrap { display: flex; align-items: center; height: 94rpx; margin-top: 28rpx; padding: 0 26rpx; border-radius: 20rpx; background: #f2f4ed; }
.modal-input { flex: 1; height: 94rpx; color: #405041; font-size: 38rpx; font-weight: 600; }
.modal-unit { color: #849181; font-size: 26rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.modal-btn { flex: 1; height: 78rpx; margin: 0; padding: 0; border-radius: 999rpx; font-size: 27rpx; line-height: 78rpx; }
.modal-cancel { background: #f0f1eb; color: #778375; }
.modal-confirm { background: #7fa36a; color: #fff; }
@media (max-width: 360px) { .page { padding-left: 22rpx; padding-right: 22rpx; } .growth-card { padding: 18rpx; } .growth-label { font-size: 22rpx; } }
