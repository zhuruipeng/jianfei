/* pages/plan-setup/plan-setup.wxss - UI 2.0 开始计划 */
.psp {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: var(--ui-color-text);
  background:
    radial-gradient(circle at 92% 2%, rgba(241, 206, 112, 0.15), transparent 280rpx),
    var(--ui-color-page);
}

.muted {
  color: var(--ui-color-text-secondary);
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 44rpx 36rpx 40rpx;
  border: 1rpx solid rgba(217, 190, 150, 0.3);
  border-radius: var(--ui-radius-hero);
  background: linear-gradient(145deg, #fffaf2 0%, #f5f4e9 54%, #edf4e5 100%);
  box-shadow: var(--ui-shadow-hero);
}

.hero-leaf {
  position: absolute;
  border-radius: 100% 0 100% 0;
  background: rgba(127, 163, 106, 0.14);
  pointer-events: none;
  transform: rotate(28deg);
}

.hero-leaf-a {
  top: -24rpx;
  right: 42rpx;
  width: 100rpx;
  height: 140rpx;
}

.hero-leaf-b {
  top: 38rpx;
  right: -28rpx;
  width: 92rpx;
  height: 126rpx;
  background: rgba(217, 190, 150, 0.17);
  transform: rotate(54deg);
}

.brand {
  position: relative;
  color: var(--ui-color-wood);
  font-size: var(--ui-font-size-label);
  font-weight: var(--ui-font-weight-semibold);
  letter-spacing: 2rpx;
  line-height: var(--ui-line-height-label);
}

.title {
  position: relative;
  margin-top: 10rpx;
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-hero);
  font-weight: var(--ui-font-weight-bold);
  line-height: var(--ui-line-height-hero);
}

.subtitle {
  position: relative;
  max-width: 520rpx;
  margin-top: 12rpx;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-body);
  line-height: 40rpx;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx 26rpx;
  border: 1rpx solid rgba(217, 190, 150, 0.24);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-color-card);
  box-shadow: var(--ui-shadow-soft);
}

.section-title {
  margin-bottom: 20rpx;
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-subtitle);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-subtitle);
}

.section-title-hint {
  color: var(--ui-color-text-weak);
  font-size: 22rpx;
  font-weight: var(--ui-font-weight-regular);
}

.opt-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.pill {
  min-width: 154rpx;
  flex: 1 1 calc(33.33% - 14rpx);
  padding: 21rpx 14rpx;
  border: 2rpx solid rgba(127, 163, 106, 0.14);
  border-radius: var(--ui-radius-md);
  background: #f4f5ed;
  text-align: center;
  transition: transform var(--ui-motion-fast) var(--ui-ease), border-color var(--ui-motion-fast) var(--ui-ease), background var(--ui-motion-fast) var(--ui-ease);
}

.pill-sm {
  min-width: 116rpx;
  flex: 1 1 calc(25% - 14rpx);
  padding: 19rpx 8rpx;
}

.pill-hover {
  transform: scale(0.98);
}

.pill-on {
  border-color: var(--ui-color-green);
  background: var(--ui-color-green-soft);
  box-shadow: inset 0 0 0 1rpx rgba(255, 252, 245, 0.7);
}

.pill-main {
  color: var(--ui-color-text);
  font-size: 28rpx;
  font-weight: var(--ui-font-weight-semibold);
  line-height: 38rpx;
}

.pill-on .pill-main {
  color: var(--ui-color-green-deep);
}

.pill-sub {
  margin-top: 5rpx;
  color: var(--ui-color-text-secondary);
  font-size: 20rpx;
  line-height: 30rpx;
}

.pill-on .pill-sub {
  color: #6f8665;
}

.input-row {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  padding: 14rpx 22rpx;
  border: 2rpx solid rgba(127, 163, 106, 0.14);
  border-radius: var(--ui-radius-md);
  background: #f4f5ed;
}

.weight-input {
  height: 54rpx;
  flex: 1;
  color: var(--ui-color-text);
  font-size: 30rpx;
  font-weight: var(--ui-font-weight-semibold);
  line-height: 54rpx;
}

.input-unit {
  margin-left: 14rpx;
  color: var(--ui-color-text-secondary);
  font-size: 25rpx;
}

.input-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 34rpx;
}

.err-msg {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(217, 134, 134, 0.18);
  border-radius: 18rpx;
  color: var(--ui-color-danger);
  background: rgba(217, 134, 134, 0.08);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.footer {
  margin-top: 32rpx;
  padding: 8rpx 4rpx 0;
}

.btn-primary {
  display: flex;
  height: 86rpx;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-pill);
  color: var(--ui-color-on-strong);
  background: var(--ui-color-green);
  box-shadow: 0 9rpx 24rpx rgba(98, 132, 78, 0.19);
  font-size: 29rpx;
  font-weight: var(--ui-font-weight-semibold);
  letter-spacing: 1rpx;
}

.btn-primary-hover {
  opacity: 0.88;
  transform: scale(0.995);
}

.btn-primary-disabled {
  opacity: 0.58;
}

.footer-tip {
  margin-top: 16rpx;
  color: var(--ui-color-text-weak);
  font-size: 21rpx;
  line-height: 32rpx;
  text-align: center;
}

@media (max-width: 360px) {
  .psp {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .section {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .pill-main {
    font-size: 26rpx;
  }
}
