/* pages/meal/meal.wxss  饮食记录页 UI 2.0 */

.meal-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(190rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 92% 2%, rgba(241, 206, 112, 0.14), transparent 260rpx),
    radial-gradient(circle at 6% 24%, rgba(127, 163, 106, 0.10), transparent 300rpx),
    var(--ui-color-page);
  color: var(--ui-color-text);
}

.meal-hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 36rpx 32rpx;
  border: 1rpx solid rgba(217, 190, 150, 0.34);
  border-radius: var(--ui-radius-hero);
  background: linear-gradient(145deg, #fffaf2 0%, #f7f3e7 52%, #eaf2e2 100%);
  box-shadow: var(--ui-shadow-hero);
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-orb-left {
  width: 180rpx;
  height: 180rpx;
  left: -86rpx;
  bottom: -96rpx;
  background: rgba(127, 163, 106, 0.10);
}

.hero-orb-right {
  width: 156rpx;
  height: 156rpx;
  top: -74rpx;
  right: -42rpx;
  background: rgba(241, 206, 112, 0.13);
}

.hero-kicker {
  position: relative;
  color: var(--ui-color-wood);
  font-size: var(--ui-font-size-label);
  font-weight: var(--ui-font-weight-medium);
  line-height: var(--ui-line-height-label);
}

.hero-main {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 8rpx;
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.hero-title {
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-hero);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-hero);
}

.hero-tip {
  margin-top: 8rpx;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-body);
  line-height: var(--ui-line-height-body);
}

.hero-icon {
  display: flex;
  width: 100rpx;
  height: 100rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 252, 245, 0.92);
  border-radius: 34rpx;
  background: rgba(255, 252, 245, 0.72);
  box-shadow: 0 10rpx 28rpx rgba(88, 96, 76, 0.08);
  font-size: 48rpx;
}

.hero-note {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--ui-radius-md);
  background: rgba(255, 252, 245, 0.72);
  color: var(--ui-color-green-deep);
  font-size: var(--ui-font-size-label);
  line-height: var(--ui-line-height-label);
}

.hero-note-leaf {
  flex: 0 0 auto;
  font-size: 26rpx;
}

.record-section {
  margin-top: 24rpx;
  padding: 28rpx 26rpx;
  border: 1rpx solid rgba(232, 225, 212, 0.82);
  border-radius: var(--ui-radius-lg);
  background: rgba(255, 252, 245, 0.94);
  box-shadow: var(--ui-shadow-soft);
}

.first-section {
  margin-top: 30rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-icon {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  font-size: 32rpx;
}

.tone-leaf { background: #edf5e9; }
.tone-sun { background: #fbf5df; }
.tone-wood { background: #f6efe4; }
.tone-water { background: #eaf4f3; }
.tone-paper { background: #f4f1e8; color: var(--ui-color-wood); }

.section-copy {
  min-width: 0;
  flex: 1;
}

.section-title {
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-subtitle);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-subtitle);
}

.section-subtitle {
  margin-top: 2rpx;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-caption);
  line-height: var(--ui-line-height-caption);
}

.optional-tag {
  flex: 0 0 auto;
  padding: 5rpx 13rpx;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-color-surface-soft);
  color: var(--ui-color-text-weak);
  font-size: 19rpx;
  line-height: 28rpx;
}

.satiety-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.satiety-item {
  position: relative;
  display: flex;
  width: 49%;
  min-height: 92rpx;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 42rpx 16rpx 16rpx;
  border: 1rpx solid var(--ui-color-border);
  border-radius: var(--ui-radius-md);
  background: #fffdf8;
  margin-bottom: 14rpx;
  transition: transform var(--ui-motion-fast) var(--ui-ease),
    background var(--ui-motion-fast) ease,
    border-color var(--ui-motion-fast) ease;
}

.satiety-item-on {
  border-color: rgba(127, 163, 106, 0.62);
  background: linear-gradient(145deg, #f2f7ea 0%, #fffdf8 100%);
  box-shadow: inset 0 0 0 1rpx rgba(127, 163, 106, 0.10);
}

.satiety-symbol {
  display: flex;
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--ui-color-surface-soft);
  font-size: 24rpx;
}

.satiety-label {
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-body);
  font-weight: var(--ui-font-weight-medium);
  line-height: var(--ui-line-height-body);
}

.choice-mark {
  position: absolute;
  top: 50%;
  right: 14rpx;
  display: flex;
  width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--ui-color-border);
  border-radius: 50%;
  background: #fffdf8;
  color: transparent;
  font-size: 18rpx;
  font-weight: var(--ui-font-weight-bold);
  transform: translateY(-50%);
}

.satiety-item-on .choice-mark {
  border-color: var(--ui-color-green);
  background: var(--ui-color-green);
  color: var(--ui-color-on-strong);
}

.photo-empty {
  display: flex;
  min-height: 300rpx;
  padding: 34rpx 24rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 2rpx dashed rgba(158, 116, 75, 0.30);
  border-radius: var(--ui-radius-lg);
  background: linear-gradient(145deg, #fffdf8 0%, #f7f3e8 100%);
  text-align: center;
  transition: transform var(--ui-motion-fast) var(--ui-ease), opacity var(--ui-motion-fast) ease;
}

.photo-empty-art {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: var(--ui-color-green-soft);
  color: var(--ui-color-green-deep);
  box-shadow: 0 10rpx 24rpx rgba(88, 96, 76, 0.08);
}

.camera-symbol {
  font-size: 50rpx;
  font-weight: 300;
  line-height: 1;
}

.photo-error-art {
  background: #f8e8e3;
  color: var(--ui-color-danger);
  font-size: 40rpx;
  font-weight: var(--ui-font-weight-bold);
}

.photo-empty-main {
  margin-top: 20rpx;
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-subtitle);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-subtitle);
}

.photo-empty-sub {
  margin-top: 6rpx;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-caption);
  line-height: var(--ui-line-height-caption);
}

.photo-pick-btn {
  margin-top: 22rpx;
  padding: 14rpx 26rpx;
  border-radius: var(--ui-radius-pill);
  background: var(--ui-color-green-soft);
  color: var(--ui-color-green-deep);
  font-size: var(--ui-font-size-label);
  font-weight: var(--ui-font-weight-semibold);
}

.photo-wrap {
  padding: 12rpx;
  border-radius: var(--ui-radius-lg);
  background: #f8f4ea;
}

.photo-preview {
  position: relative;
  width: 100%;
  height: 410rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: var(--ui-color-surface-soft);
  transition: opacity var(--ui-motion-fast) ease;
}

.photo-preview-hover { opacity: 0.92; }

.photo-img {
  display: block;
  width: 100%;
  height: 100%;
}

.photo-preview-tip {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--ui-radius-pill);
  background: rgba(53, 72, 59, 0.62);
  color: #fffdf8;
  font-size: 19rpx;
  line-height: 28rpx;
}

.photo-action-row {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 14rpx 6rpx 4rpx;
}

.photo-action-btn {
  padding: 12rpx 22rpx;
  border: 1rpx solid var(--ui-color-border);
  border-radius: var(--ui-radius-pill);
  background: #fffdf8;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-label);
  line-height: var(--ui-line-height-label);
}

.photo-action-btn.danger { color: var(--ui-color-danger); }

.input-paper {
  padding: 22rpx 22rpx 14rpx;
  border: 1rpx solid rgba(232, 225, 212, 0.90);
  border-radius: var(--ui-radius-md);
  background: #fffdf8;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-body);
  line-height: 40rpx;
}

.food-textarea { min-height: 118rpx; }
.note-textarea { min-height: 150rpx; }
.textarea-placeholder { color: var(--ui-color-text-weak); }

.count-line {
  margin-top: 8rpx;
  color: var(--ui-color-text-weak);
  font-size: 19rpx;
  line-height: 28rpx;
  text-align: right;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-chip {
  position: relative;
  display: inline-flex;
  min-height: 68rpx;
  align-items: center;
  gap: 9rpx;
  padding: 10rpx 34rpx 10rpx 18rpx;
  border: 1rpx solid var(--ui-color-border);
  border-radius: var(--ui-radius-pill);
  background: #fffdf8;
  transition: transform var(--ui-motion-fast) var(--ui-ease),
    background var(--ui-motion-fast) ease,
    border-color var(--ui-motion-fast) ease;
}

.tag-chip-on {
  border-color: rgba(127, 163, 106, 0.54);
  background: var(--ui-color-green-soft);
}

.tag-emoji {
  font-size: 26rpx;
  line-height: 1;
}

.tag-label {
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-label);
  font-weight: var(--ui-font-weight-medium);
  line-height: var(--ui-line-height-label);
}

.tag-mark {
  position: absolute;
  top: 50%;
  right: 12rpx;
  color: var(--ui-color-green-deep);
  font-size: 18rpx;
  font-weight: var(--ui-font-weight-bold);
  transform: translateY(-50%);
}

.gentle-reminder {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 28rpx 10rpx 0;
  color: var(--ui-color-text-weak);
  font-size: var(--ui-font-size-caption);
  line-height: var(--ui-line-height-caption);
  text-align: center;
}

.reminder-icon {
  flex: 0 0 auto;
  font-size: 24rpx;
}

.bottom-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(232, 225, 212, 0.72);
  background: rgba(255, 252, 245, 0.96);
  box-shadow: 0 -12rpx 32rpx rgba(88, 96, 76, 0.08);
}

.btn-primary,
.btn-delete {
  display: flex;
  height: 86rpx;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-pill);
  transition: transform var(--ui-motion-fast) var(--ui-ease), opacity var(--ui-motion-fast) ease;
}

.btn-primary {
  min-width: 0;
  flex: 1;
  gap: 12rpx;
  background: linear-gradient(135deg, #779d67 0%, #668b5e 100%);
  color: var(--ui-color-on-strong);
  box-shadow: 0 10rpx 26rpx rgba(73, 102, 78, 0.20);
  font-size: var(--ui-font-size-subtitle);
  font-weight: var(--ui-font-weight-semibold);
}

.btn-arrow {
  font-size: 30rpx;
  font-weight: var(--ui-font-weight-regular);
}

.btn-delete {
  width: 180rpx;
  flex: 0 0 auto;
  border: 1rpx solid rgba(217, 134, 134, 0.38);
  background: #fffaf5;
  color: var(--ui-color-danger);
  font-size: var(--ui-font-size-label);
  font-weight: var(--ui-font-weight-medium);
}

.btn-primary-hover,
.soft-press {
  transform: scale(0.98);
  opacity: 0.90;
}

@media (max-width: 350px) {
  .meal-page {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .record-section {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .satiety-label { font-size: 22rpx; }
  .btn-delete { width: 160rpx; }
}
