/* pages/meal/meal.wxss  V8 视觉 tokens 统一 */
.meal-page {
  padding: 24rpx 32rpx 300rpx 32rpx;  /* V8: 左右边距统一 32rpx, 底部更多安全 */
  background: #F7F8FA;
  min-height: 100vh;
  box-sizing: border-box;
}

.hero-card {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E7A 55%, #FFB199 100%);
  color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 32rpx 32rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.16);
  margin-bottom: 24rpx;
}
.hero-head { display: flex; flex-direction: column; }
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.hero-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.55;
}

.section { margin-top: 32rpx; }
.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3245;
  padding: 0 4rpx 18rpx 4rpx;
}
.section-subtitle {
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 0;
}

/* ========= V8 新增：快速记录（顶置 4 格一键饱腹） ========= */
.quick-section .section-title { padding-bottom: 20rpx; }
.quick-grid {
  display: flex;
  flex-wrap: wrap;
}
.quick-item {
  width: 25%;
  box-sizing: border-box;
  padding-right: 8rpx;
  padding-left: 8rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #E7EAF1;
  border-radius: 24rpx;
  padding-top: 24rpx;
  padding-bottom: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  transition: transform .1s, box-shadow .2s;
}
.quick-item-hover { transform: scale(0.97); opacity: .92; }
.quick-item-on {
  border-color: #FF6B6B;
  background: linear-gradient(180deg, #FFF0EE 0%, #FFFFFF 100%);
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 107, 0.12);
}
.quick-icon {
  width: 60rpx; height: 60rpx;
  border-radius: 50%;
  background: rgba(78, 205, 196, 0.10);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx;
}
.quick-item-on .quick-icon {
  background: rgba(255, 107, 107, 0.15);
}
.quick-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C3245;
  text-align: center;
}
.quick-item-on .quick-label {
  color: #FF6B6B;
}

.textarea-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 24rpx 20rpx 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(23, 43, 77, 0.05);
}
.textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #2C3245;
  box-sizing: border-box;
}
.textarea-placeholder { color: #B8BFCD; }
.count-line {
  margin-top: 8rpx;
  display: flex;
  justify-content: flex-end;
}
.count-text { font-size: 22rpx; }
.muted { color: #9AA3B6; }

/* 饱腹单选 2x2 */
.satiety-grid {
  display: flex;
  flex-wrap: wrap;
}
.satiety-item {
  width: 50%;
  box-sizing: border-box;
  padding: 26rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  transition: transform .1s;
}
.satiety-item-hover { transform: scale(0.98); opacity: .9; }
.satiety-item-on {
  border-color: #FF6B6B;
  background: linear-gradient(135deg, #FFF0EE 0%, #FFFFFF 100%);
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 107, 0.10);
}
.satiety-head { font-size: 40rpx; width: 48rpx; text-align: center; }
.satiety-label { font-size: 30rpx; color: #2C3245; font-weight: 600; }

/* 标签 chip */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.tag-chip {
  background: #FFFFFF;
  border: 2rpx solid #E7EAF1;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  transition: transform .1s;
}
.tag-chip-hover { transform: scale(0.98); opacity: .9; }
.tag-chip-on {
  border-color: #4ECDC4;
  background: linear-gradient(135deg, #EDFDFA 0%, #FFFFFF 100%);
}
.tag-check { font-size: 26rpx; }
.tag-label { font-size: 28rpx; color: #2C3245; }

/* 底部按钮 V8：统一 84rpx 高主按钮；删除按钮 80rpx */
.bottom-actions {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 32rpx 28rpx 32rpx;
  background: linear-gradient(180deg, rgba(247,248,250,0) 0%, rgba(247,248,250,1) 35%);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
  z-index: 10;
}
.btn-primary {
  background: linear-gradient(90deg, #4ECDC4 0%, #FF6B6B 100%);
  color: #FFFFFF;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 22rpx rgba(255, 107, 107, 0.18);
}
.btn-primary-hover { transform: scale(0.98); opacity: .9; }

.btn-delete {
  background: #FFFFFF;
  color: #D04343;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid #F1CBCB;
}
.btn-delete-hover { transform: scale(0.98); opacity: .9; }
.bottom-safe { height: 40rpx; }

/* =========================
   新增：照片区域样式
   ========================= */
.photo-section {
  margin-top: 32rpx;
}

/* 占位卡（未选 / 加载失败） */
.photo-empty {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 44rpx 28rpx 40rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: 2rpx dashed #C9D0DB;
  transition: transform .1s ease;
}
.photo-empty-hover { transform: scale(0.99); opacity: .95; }

.photo-empty-icon { font-size: 72rpx; line-height: 1; }
.photo-empty-main {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3245;
}
.photo-empty-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8A93A5;
}

.photo-empty-actions {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}
.photo-pick-btn {
  padding: 18rpx 34rpx;
  border-radius: 999rpx;
  background: #F7F8FA;
  border: 2rpx solid #E7EAF1;
  color: #374151;
  font-size: 28rpx;
  font-weight: 600;
}
.photo-pick-btn-primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E7A 100%);
  border: none;
  color: #FFFFFF;
  box-shadow: 0 8rpx 18rpx rgba(255,107,107,0.20);
}

/* 已有照片：圆角卡片 + 2 按钮 */
.photo-wrap {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 18rpx 18rpx 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(31,41,55,0.05);
}
.photo-preview {
  width: 100%;
  height: 420rpx;
  background: #F2F4F8;
  border-radius: 20rpx;
  overflow: hidden;
}
.photo-preview-hover { opacity: .95; }
.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-action-row {
  margin-top: 18rpx;
  display: flex;
  gap: 18rpx;
  justify-content: flex-end;
}
.photo-action-btn {
  height: 72rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  transition: transform .1s ease, opacity .1s ease;
}
.photo-action-btn-hover { transform: scale(0.98); opacity: .92; }
.photo-action-btn.outline {
  background: #F7F8FA;
  border: 2rpx solid #E7EAF1;
  color: #374151;
}
.photo-action-btn.danger-outline {
  background: #FFFFFF;
  border: 2rpx solid #F1CBCB;
  color: #D04343;
}

/* =========================
   AI 区域（V6）
   ========================= */
.ai-section { margin-top: 36rpx; }

.ai-disabled-card {
  background: #F7F8FA;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  border: 2rpx solid #E7EAF1;
}
.ai-disabled-text {
  font-size: 28rpx;
  color: #8A93A5;
  line-height: 1.4;
}

.ai-row {
  display: flex;
  align-items: center;
  justify-content: center;
}
.ai-btn {
  height: 84rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #6D7BFF 0%, #8B8BFF 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(109,123,255,0.20);
  transition: transform .1s ease, opacity .1s ease;
}
.ai-btn-hover { transform: scale(0.98); opacity: .92; }
.ai-emoji { font-size: 32rpx; line-height: 1; }
.ai-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.ai-btn-disabled {
  background: #CDD2DC;
  color: #FFFFFF;
  box-shadow: none;
  opacity: .9;
}

/* loading 小圆（动画，微信原生不支持 @keyframes 的话退化为静态点也 ok） */
.loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #FFFFFF;
  opacity: .8;
  animation: aiBlink 1s steps(2) infinite;
}
@keyframes aiBlink {
  0%,100% { opacity: .3; }
  50%     { opacity: 1; }
}

.ai-hint-row {
  margin-top: 22rpx;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  line-height: 1.55;
  white-space: pre-line;
}
.ai-hint-info {
  background: #EEF1FB;
  color: #414DA7;
}
.ai-hint-failed {
  background: #FDEFEE;
  color: #B54545;
}

/* =========================
   AI 失败卡片 / 结果卡片（V7）
   ========================= */
.ai-failed-card {
  margin-top: 22rpx;
  background: #FFF8F6;
  border: 2rpx solid #F3DAD3;
  border-radius: 20rpx;
  padding: 26rpx 24rpx 22rpx;
}
.ai-failed-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #C24B3F;
  margin-bottom: 8rpx;
}
.ai-failed-sub {
  font-size: 26rpx;
  color: #7B6460;
  line-height: 1.55;
}

.ai-result-card {
  margin-top: 22rpx;
  background: #F7F4FF;
  border: 2rpx solid #E2D9FB;
  border-radius: 22rpx;
  padding: 28rpx 24rpx 22rpx;
}
.ai-result-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #523FBF;
  margin-bottom: 14rpx;
}
.ai-foods {
  font-size: 28rpx;
  color: #3B3755;
  line-height: 1.55;
  margin-bottom: 18rpx;
}
.ai-food-item {
  color: #4B4192;
  font-weight: 600;
}

.ai-section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 2rpx dashed #DED7F4;
}
.ai-label {
  font-size: 26rpx;
  color: #7E769E;
}
.ai-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #3B3755;
}

.ai-struct-grid {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 18rpx;
}
.ai-struct-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 18rpx 14rpx;
  text-align: center;
  box-shadow: inset 0 0 0 2rpx #EFEAFB;
}
.ai-struct-title {
  font-size: 24rpx;
  color: #7E769E;
  margin-bottom: 6rpx;
}
.ai-struct-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #4B4192;
  line-height: 1.35;
}

.ai-divider {
  margin: 22rpx 0 18rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(140,120,255,0) 0%, rgba(140,120,255,0.45) 50%, rgba(140,120,255,0) 100%);
}
.ai-suggestion-label {
  font-size: 26rpx;
  color: #7E769E;
  margin-bottom: 10rpx;
}
.ai-suggestion {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #3B3755;
  white-space: pre-line;
  box-shadow: inset 0 0 0 2rpx #EFEAFB;
}

.ai-confidence-low-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9A7A1D;
  background: #FFF7E0;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  line-height: 1.5;
}
.ai-disclaimer {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9A93B6;
  text-align: center;
}
.ai-result-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 20rpx;
}
.ai-result-actions .photo-action-btn {
  padding: 14rpx 28rpx;
  height: auto;
  line-height: 1.3;
}
.ai-dirty-hint {
  margin-top: 18rpx;
  background: #FFF6E7;
  color: #8A6A1E;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  line-height: 1.55;
}
.ai-dirty-link {
  color: #B47A1F;
  text-decoration: underline;
  margin-left: 10rpx;
  font-weight: 600;
}
