<!--pages/meal/meal.wxml  V8：快速记录顶置，其余字段可选-->
<view class="meal-page">
  <!-- 头部大卡片 -->
  <view class="hero-card">
    <view class="hero-head">
      <view class="hero-title">{{pageTitle}}</view>
      <view class="hero-tip">不用每顿都完美，先记下来就好。</view>
    </view>
  </view>

  <!-- 快速记录（顶置，2 步完成：一键饱腹 + 保存） -->
  <view class="section quick-section">
    <view class="section-title">
      <text>快速记录</text>
      <text class="section-subtitle muted">点一下，再点保存就完成</text>
    </view>
    <view class="quick-grid">
      <block wx:for="{{satietyOptions}}" wx:key="level">
        <view
          class="quick-item {{item.emoji === '✅' ? 'quick-item-on' : ''}}"
          data-level="{{item.level}}"
          bindtap="selectSatiety"
          hover-class="quick-item-hover"
        >
          <view class="quick-icon">{{item.emoji === '✅' ? '🟟' : '🟟'}}</view>
          <view class="quick-label">{{item.label}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- ========= 新增：照片区域（这一餐） ========= -->
  <view class="section photo-section">
    <view class="section-title">这一餐</view>

    <!-- 未选照片：大占位卡 -->
    <block wx:if="{{!photoPath || photoError}}">
      <view
        class="photo-empty"
        bindtap="onClickPickPhoto"
        hover-class="photo-empty-hover"
      >
        <block wx:if="{{photoPath && photoError}}">
          <view class="photo-empty-icon">🟠</view>
          <view class="photo-empty-main">照片暂时无法显示</view>
          <view class="photo-empty-sub">可以重新选择或删除</view>
          <view class="photo-empty-actions">
            <view class="photo-pick-btn photo-pick-btn-primary">
              <text>重新选择</text>
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="photo-empty-icon">🟟</view>
          <view class="photo-empty-main">拍下这一餐</view>
          <view class="photo-empty-sub">留下一张今天的饮食记录</view>
          <view class="photo-empty-actions">
            <view class="photo-pick-btn">
              <text>📷 拍照 / 从相册选择</text>
            </view>
          </view>
        </block>
      </view>
    </block>

    <!-- 已有照片：预览 + 重新选择/删除 -->
    <block wx:else>
      <view class="photo-wrap">
        <view
          class="photo-preview"
          bindtap="onClickPreviewPhoto"
          hover-class="photo-preview-hover"
        >
          <image
            class="photo-img"
            src="{{photoPath}}"
            mode="aspectFill"
            binderror="onPhotoError"
            show-menu-by-longpress="{{false}}"
          />
        </view>
        <view class="photo-action-row">
          <view
            class="photo-action-btn outline"
            bindtap="onClickPickPhoto"
            hover-class="photo-action-btn-hover"
          >
            <text>重新选择</text>
          </view>
          <view
            class="photo-action-btn danger-outline"
            bindtap="onClickDeletePhoto"
            hover-class="photo-action-btn-hover"
          >
            <text>删除照片</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 吃了什么 -->
  <view class="section">
    <view class="section-title">今天吃了什么？</view>
    <view class="textarea-card">
      <textarea
        class="textarea"
        placeholder="例如：米饭、鸡肉、青菜"
        placeholder-class="textarea-placeholder"
        maxlength="100"
        value="{{foodText}}"
        auto-height
        bindinput="onInputFood"
      />
      <view class="count-line">
        <text class="count-text muted">{{foodText.length}}/100（可空）</text>
      </view>
    </view>
  </view>

  <!-- 饱腹程度 -->
  <view class="section">
    <view class="section-title">吃到什么程度？</view>
    <view class="satiety-grid">
      <block wx:for="{{satietyOptions}}" wx:key="level">
        <view
          class="satiety-item {{item.emoji === '✅' ? 'satiety-item-on' : ''}}"
          data-level="{{item.level}}"
          bindtap="selectSatiety"
          hover-class="satiety-item-hover"
        >
          <view class="satiety-head">{{item.emoji}}</view>
          <view class="satiety-label">{{item.label}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 标签多选 -->
  <view class="section">
    <view class="section-title">这一餐有什么？</view>
    <view class="tag-grid">
      <block wx:for="{{tagOptions}}" wx:key="key">
        <view
          class="tag-chip {{item.selected ? 'tag-chip-on' : ''}}"
          data-key="{{item.key}}"
          bindtap="toggleTag"
          hover-class="tag-chip-hover"
        >
          <text class="tag-check">{{item.selected ? '✅' : '🟟'}}</text>
          <text class="tag-label">{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section">
    <view class="section-title">备注</view>
    <view class="textarea-card">
      <textarea
        class="textarea"
        placeholder="今天聚餐，吃得比平时多一点"
        placeholder-class="textarea-placeholder"
        maxlength="200"
        value="{{note}}"
        auto-height
        bindinput="onInputNote"
      />
      <view class="count-line">
        <text class="count-text muted">{{note.length}}/200（可空）</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮区 -->
  <view class="bottom-actions">
    <block wx:if="{{hasRecord}}">
      <view class="btn-delete" bindtap="onClickDelete" hover-class="btn-delete-hover">
        <text>删除本次记录</text>
      </view>
    </block>
    <view class="btn-primary" bindtap="onClickSave" hover-class="btn-primary-hover">
      <text>{{isEdit ? '保存修改' : '保存'}}</text>
    </view>
  </view>
  <view class="bottom-safe"/>
</view>
