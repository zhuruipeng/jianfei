/* pages/plan-summary/plan-summary.wxss  V10 28/90 天计划总结页 */
.psmp {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF0EE 0%, #F7F8FA 35%);
  padding: 96rpx 48rpx calc(env(safe-area-inset-bottom) + 40rpx) 48rpx;
  box-sizing: border-box;
}
.muted { color: #8A93A5; }

/* ============ Hero ============ */
.hero { margin-bottom: 40rpx; }
.brand {
  font-size: 32rpx;
  color: #FF6B6B;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.title {
  margin-top: 16rpx;
  font-size: 48rpx;
  line-height: 1.35;
  color: #1F2937;
  font-weight: 800;
}
.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

/* ============ Lead 主文案 ============ */
.lead {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(31, 41, 55, 0.04);
}
.lead-main {
  font-size: 32rpx;
  color: #1F2937;
  font-weight: 700;
  line-height: 1.6;
}
.lead-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

/* ============ Section ============ */
.section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(31, 41, 55, 0.04);
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 20rpx;
}

/* ============ 指标行 ============ */
.metric-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 18rpx 0;
}
.metric-row + .metric-row {
  border-top: 1rpx solid rgba(138, 147, 165, 0.10);
}
.metric-label {
  font-size: 28rpx;
  color: #8A93A5;
}
.metric-value {
  font-size: 30rpx;
  color: #1F2937;
  font-weight: 700;
}

/* ============ 体重变化 ============ */
.weight-flow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 16rpx 0 8rpx 0;
}
.weight-pill {
  flex: 1;
  background: #F7F8FA;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}
.weight-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #1F2937;
  line-height: 1.2;
}
.weight-tag {
  margin-top: 8rpx;
  font-size: 22rpx;
}
.weight-arrow {
  font-size: 40rpx;
  color: #B9C0CD;
  font-weight: 600;
}
.weight-change {
  margin-top: 16rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
}
.wc-down { color: #4ECDC4; }
.wc-up { color: #FF6B6B; }
.weight-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}

/* ============ 错误提示 ============ */
.err-msg {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  background: rgba(255, 107, 107, 0.08);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #FF6B6B;
  text-align: center;
}

/* ============ 底部按钮 ============ */
.footer { margin-top: 48rpx; }
.btn-primary {
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4ECDC4 0%, #FF6B6B 100%);
  color: #FFFFFF;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.20);
}
.btn-primary-hover { opacity: .92; }
.btn-secondary {
  margin-top: 20rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 2rpx solid #E7EAF1;
  color: #1F2937;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-secondary-hover { background: #F7F8FA; }
.footer-tip {
  text-align: center;
  margin-top: 20rpx;
  font-size: 24rpx;
}
