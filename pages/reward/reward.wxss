/* pages/reward/reward.wxss 奖励页 UI 2.0 */

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(168rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 92% 3%, rgba(239, 183, 194, 0.14), transparent 260rpx),
    var(--ui-color-page);
}

.gift-hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 36rpx 36rpx;
  border: 1rpx solid rgba(217, 190, 150, 0.34);
  border-radius: var(--ui-radius-hero);
  background: linear-gradient(145deg, #fffaf2 0%, #f7f3e7 52%, #edf4e5 100%);
  box-shadow: var(--ui-shadow-hero);
}

.hero-decoration {
  position: absolute;
  opacity: 0.16;
  pointer-events: none;
}

.hero-decoration-left {
  bottom: 120rpx;
  left: -18rpx;
  font-size: 96rpx;
  transform: rotate(-22deg);
}

.hero-decoration-right {
  top: 26rpx;
  right: 30rpx;
  color: var(--ui-color-wood);
  font-size: 40rpx;
}

.hero-kicker {
  color: var(--ui-color-wood);
  font-size: var(--ui-font-size-label);
  font-weight: var(--ui-font-weight-medium);
  line-height: var(--ui-line-height-label);
}

.hero-title {
  margin-top: 10rpx;
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-hero);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-hero);
}

.hero-gift {
  font-size: 38rpx;
}

.hero-copy {
  margin-top: 12rpx;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-body);
  line-height: 38rpx;
}

.effort-block {
  position: relative;
  margin-top: 32rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(255, 252, 245, 0.7);
  border-radius: var(--ui-radius-lg);
  background: rgba(255, 252, 245, 0.68);
}

.effort-label {
  display: block;
  color: var(--ui-color-green-deep);
  font-size: var(--ui-font-size-label);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-label);
}

.effort-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 2rpx;
}

.effort-value {
  color: var(--ui-color-green-deep);
  font-size: 68rpx;
  font-weight: var(--ui-font-weight-bold);
  line-height: 86rpx;
}

.effort-unit {
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-label);
}

.effort-tip {
  display: block;
  margin-top: 4rpx;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-caption);
  line-height: var(--ui-line-height-caption);
}

.next-section,
.list-header {
  margin-top: 34rpx;
}

.next-section ui-soft-card {
  display: block;
  margin-top: 16rpx;
}

.next-reward-head,
.reward-card-head,
.reward-identity,
.next-progress-copy,
.card-progress-copy,
.redeemed-note {
  display: flex;
}

.next-reward-head,
.reward-card-head {
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.reward-identity {
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 18rpx;
}

.reward-icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: var(--ui-color-surface-soft);
  font-size: 40rpx;
  line-height: 1;
}

.reward-icon-warm {
  background: rgba(217, 190, 150, 0.22);
}

.reward-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.next-reward-title,
.reward-title {
  overflow: hidden;
  color: var(--ui-color-text);
  font-weight: var(--ui-font-weight-semibold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.next-reward-title {
  font-size: var(--ui-font-size-subtitle);
  line-height: var(--ui-line-height-subtitle);
}

.reward-title {
  font-size: 27rpx;
  line-height: 40rpx;
}

.next-state,
.reward-state {
  margin-top: 4rpx;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-caption);
  line-height: var(--ui-line-height-caption);
}

.next-state.is-ready,
.reward-state.is-ready {
  color: var(--ui-color-wood);
  font-weight: var(--ui-font-weight-semibold);
}

.next-progress-copy,
.card-progress-copy {
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.next-progress-copy {
  margin: 30rpx 0 12rpx;
}

.card-progress-copy {
  margin: 24rpx 0 12rpx;
}

.progress-numbers {
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-body);
  font-weight: var(--ui-font-weight-semibold);
  white-space: nowrap;
}

.progress-helper {
  overflow: hidden;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-caption);
  line-height: var(--ui-line-height-caption);
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.create-reward {
  margin-top: 24rpx;
}

.create-reward ui-soft-button,
.empty-action ui-soft-button,
.card-primary-action ui-soft-button,
.feedback-dialog ui-soft-button {
  display: block;
  width: 100%;
}

.reward-card {
  margin-top: 18rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(232, 225, 212, 0.86);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-color-card);
  box-shadow: var(--ui-shadow-soft);
}

.reward-card.is-unlocked {
  border-color: rgba(217, 190, 150, 0.62);
  background: linear-gradient(145deg, #fffdf7, #fbf5e8);
}

.reward-card.is-redeemed {
  background: rgba(255, 252, 245, 0.62);
  box-shadow: none;
}

.more-button {
  display: flex;
  width: 64rpx;
  height: 56rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-pill);
  color: var(--ui-color-text-secondary);
  background: rgba(127, 163, 106, 0.1);
  font-size: 28rpx;
  font-weight: var(--ui-font-weight-bold);
  letter-spacing: 2rpx;
  line-height: 1;
}

.more-button-active {
  opacity: 0.66;
  transform: scale(0.96);
}

.card-primary-action {
  margin-top: 22rpx;
}

.redeemed-note {
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--ui-radius-md);
  color: var(--ui-color-text-secondary);
  background: rgba(231, 240, 219, 0.52);
  font-size: var(--ui-font-size-caption);
  line-height: var(--ui-line-height-caption);
}

.redeemed-leaf {
  flex: none;
}

.redeemed-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.redeemed-time {
  margin-top: 4rpx;
  color: var(--ui-color-text-weak);
}

.empty-state {
  display: flex;
  margin-top: 34rpx;
  padding: 54rpx 34rpx 44rpx;
  align-items: center;
  flex-direction: column;
  border: 1rpx solid rgba(217, 190, 150, 0.38);
  border-radius: var(--ui-radius-hero);
  background: linear-gradient(155deg, #fffdf7, #f2f6e8);
  box-shadow: var(--ui-shadow-soft);
  text-align: center;
}

.empty-illustration {
  position: relative;
  width: 176rpx;
  height: 148rpx;
}

.empty-gift {
  position: absolute;
  top: 22rpx;
  left: 50%;
  font-size: 88rpx;
  transform: translateX(-50%);
}

.empty-leaf {
  position: absolute;
  bottom: 0;
  font-size: 38rpx;
  opacity: 0.68;
}

.empty-leaf-left {
  left: 0;
  transform: rotate(-14deg);
}

.empty-leaf-right {
  right: 0;
  transform: rotate(12deg);
}

.empty-title {
  margin-top: 12rpx;
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-subtitle);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-subtitle);
}

.empty-desc {
  margin-top: 10rpx;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-body);
  line-height: var(--ui-line-height-body);
}

.empty-action {
  width: 100%;
  margin-top: 30rpx;
}

.feedback-overlay {
  position: fixed;
  z-index: 200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  background: rgba(53, 72, 59, 0.28);
  animation: overlay-in var(--ui-motion-normal) ease both;
}

.feedback-dialog {
  display: flex;
  width: 100%;
  max-width: 620rpx;
  padding: 42rpx 34rpx 34rpx;
  align-items: center;
  flex-direction: column;
  border: 1rpx solid rgba(217, 190, 150, 0.52);
  border-radius: var(--ui-radius-hero);
  background: linear-gradient(155deg, #fffdf7, #f7f2e6);
  box-shadow: var(--ui-shadow-float);
  text-align: center;
  animation: dialog-in var(--ui-motion-normal) var(--ui-ease) both;
}

.feedback-icon {
  font-size: 78rpx;
  line-height: 1;
}

.feedback-title {
  margin-top: 24rpx;
  color: var(--ui-color-text);
  font-size: var(--ui-font-size-subtitle);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-subtitle);
}

.feedback-reward {
  max-width: 100%;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--ui-color-wood);
  font-size: var(--ui-font-size-body);
  font-weight: var(--ui-font-weight-semibold);
  line-height: var(--ui-line-height-body);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feedback-copy {
  margin: 20rpx 0 30rpx;
  color: var(--ui-color-text-secondary);
  font-size: var(--ui-font-size-body);
  line-height: 40rpx;
}

.bottom-space {
  height: 24rpx;
}

@keyframes overlay-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes dialog-in {
  from {
    opacity: 0;
    transform: translateY(18rpx) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 375px) {
  .page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .gift-hero {
    padding: 34rpx 30rpx 30rpx;
  }

  .effort-block {
    margin-top: 26rpx;
  }

  .reward-card {
    padding: 23rpx;
  }
}
