<!-- pages/reward/reward.wxml 奖励页 UI 2.0 -->
<view class="page">
  <view class="gift-hero">
    <view class="hero-decoration hero-decoration-left">🌿</view>
    <view class="hero-decoration hero-decoration-right">✦</view>
    <view class="hero-kicker">给一直在坚持的自己一点期待</view>
    <view class="hero-title">给自己的小礼物 <text class="hero-gift">🎁</text></view>
    <view class="hero-copy">这些不是任务，<br />是给坚持下来的自己一点期待。</view>
    <view class="effort-block">
      <text class="effort-label">累计努力</text>
      <view class="effort-value-row">
        <text class="effort-value">{{totalPoints}}</text>
        <text class="effort-unit">点</text>
      </view>
      <text class="effort-tip">{{heroTip}}</text>
    </view>
  </view>

  <view wx:if="{{nextExpectation}}" class="next-section">
    <ui-section-header
      title="下一个期待"
      subtitle="离你最近的那份小礼物"
      icon="🌱"
    />
    <ui-soft-card variant="paper" padding="lg">
      <view class="next-reward-head">
        <view class="reward-identity">
          <view class="reward-icon reward-icon-warm">{{nextExpectation.reward.emoji}}</view>
          <view class="reward-copy">
            <text class="next-reward-title">{{nextExpectation.reward.title}}</text>
            <text class="next-state {{nextExpectation.achieved ? 'is-ready' : ''}}">{{nextExpectation.stateText}}</text>
          </view>
        </view>
      </view>
      <view class="next-progress-copy">
        <text class="progress-numbers">{{nextExpectation.progress.current}} / {{nextExpectation.progress.required}}</text>
        <text class="progress-helper">{{nextExpectation.helperText}}</text>
      </view>
      <ui-progress-bar
        value="{{nextExpectation.progress.current}}"
        max="{{nextExpectation.progress.required}}"
        tone="wood"
        height="12"
      />
    </ui-soft-card>
  </view>

  <view wx:if="{{displayRewards.length > 0}}" class="create-reward">
    <ui-soft-button
      text="＋ 给自己准备一个奖励"
      variant="secondary"
      size="lg"
      full-width
      bind:tap="onClickNewReward"
    />
  </view>

  <block wx:if="{{displayRewards.length > 0}}">
    <view class="list-header">
      <ui-section-header
        title="我为自己准备的奖励"
        subtitle="每一份期待，都来自真实的坚持"
        icon="🎀"
      />
    </view>

    <view
      class="reward-card {{item.reward.redeemed ? 'is-redeemed' : (item.achieved ? 'is-unlocked' : '')}}"
      wx:for="{{displayRewards}}"
      wx:key="id"
    >
      <view class="reward-card-head">
        <view class="reward-identity">
          <view class="reward-icon">{{item.reward.emoji}}</view>
          <view class="reward-copy">
            <text class="reward-title">{{item.reward.title}}</text>
            <text class="reward-state {{item.achieved && !item.reward.redeemed ? 'is-ready' : ''}}">
              {{item.reward.redeemed ? '✓ ' : ''}}{{item.stateText}}
            </text>
          </view>
        </view>
        <view
          class="more-button"
          data-id="{{item.reward.id}}"
          catchtap="onClickRewardMore"
          hover-class="more-button-active"
          aria-role="button"
          aria-label="管理奖励"
        >•••</view>
      </view>

      <block wx:if="{{!item.reward.redeemed}}">
        <view class="card-progress-copy">
          <text class="progress-numbers">{{item.progress.current}} / {{item.progress.required}}</text>
          <text class="progress-helper">
            {{item.achieved ? '已经准备好了 🎉' : '还差 ' + item.progress.remain + ' 点'}}
          </text>
        </view>
        <ui-progress-bar
          value="{{item.progress.current}}"
          max="{{item.progress.required}}"
          tone="green"
          height="10"
        />

        <view wx:if="{{item.achieved}}" class="card-primary-action">
          <ui-soft-button
            text="领取小礼物"
            variant="primary"
            size="md"
            full-width
            data-id="{{item.reward.id}}"
            bind:tap="onClickRedeemReward"
          />
        </view>
      </block>

      <view wx:else class="redeemed-note">
        <text class="redeemed-leaf">🌿</text>
        <view class="redeemed-copy">
          <text>这是你走过的路留下的小礼物。</text>
          <text wx:if="{{item.reward.redeemedAt}}" class="redeemed-time">领取于 {{item.reward.redeemedAt}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="empty-state">
    <view class="empty-illustration">
      <text class="empty-gift">🎁</text>
      <text class="empty-leaf empty-leaf-left">🌿</text>
      <text class="empty-leaf empty-leaf-right">🌱</text>
    </view>
    <text class="empty-title">还没有给自己准备奖励</text>
    <text class="empty-desc">给坚持这件事留一点期待吧。</text>
    <view class="empty-action">
      <ui-soft-button
        text="设置第一个奖励"
        variant="primary"
        size="lg"
        full-width
        bind:tap="onClickNewReward"
      />
    </view>
  </view>

  <view class="bottom-space"></view>
</view>

<view
  wx:if="{{redeemFeedbackVisible}}"
  class="feedback-overlay"
  catchtap="onCloseRedeemFeedback"
  catchtouchmove="preventOverlayTap"
>
  <view class="feedback-dialog" catchtap="preventOverlayTap">
    <view class="feedback-icon">🎁</view>
    <text class="feedback-title">这份小礼物已经属于你啦</text>
    <text class="feedback-reward">{{redeemFeedbackTitle}}</text>
    <text class="feedback-copy">这是你自己一步一步走来的。<br />去好好享受它吧。</text>
    <ui-soft-button
      text="我知道啦"
      variant="primary"
      size="md"
      full-width
      bind:tap="onCloseRedeemFeedback"
    />
  </view>
</view>
