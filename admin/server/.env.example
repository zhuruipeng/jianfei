# ============================================================
# 轻步 · 用户反馈管理员后台 - 环境变量配置
# ============================================================
# 复制本文件为 .env，填好后重启服务

# ---------- 小程序配置 ----------
# 微信公众平台 → 开发 → 开发设置 → AppID
QINGBU_APPID=your_appid_here

# 微信公众平台 → 开发 → 开发设置 → AppSecret
QINGBU_SECRET=your_secret_here

# 云开发环境 ID（云开发控制台顶部，形如 prod-0xxxxxx）
QINGBU_ENV_ID=your_env_id_here

# ---------- 云函数鉴权 ----------
# 与 listFeedback / updateFeedbackStatus 云函数环境变量里配的同一个 token
FEEDBACK_ADMIN_TOKEN=your_long_random_token_here

# ---------- 管理员账号密码 ----------
# 自己定，建议密码至少 12 位
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_strong_password

# ---------- Session 签名密钥 ----------
# 任意长随机串，用以下命令生成：
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your_random_session_secret_here

# ---------- 可选 ----------
# 服务端口
PORT=5000

# 是否开启 debug 模式（生产环境务必为 0）
DEBUG=0

# 是否强制 HTTPS（上线后设 1，session cookie 才会走 Secure）
FORCE_HTTPS=0
