.ui-theme {
  --ui-color-page: #F7F4EA;
  --ui-color-surface: #FFFCF5;
  --ui-color-surface-soft: #F2F6E8;
  --ui-color-green-soft: #E7F0DB;
  --ui-color-green: #7FA36A;
  --ui-color-green-deep: #49664E;
  --ui-color-wood-light: #D9BE96;
  --ui-color-wood: #9E744B;
  --ui-color-water: #82C5D6;
  --ui-color-sun: #F1CE70;
  --ui-color-pink: #EFB7C2;
  --ui-color-text: #35483B;
  --ui-color-text-secondary: #778075;
  --ui-color-text-weak: #A0A59B;
  --ui-color-border: #E8E1D4;
  --ui-color-success: #72A45F;
  --ui-color-progress: #E4A239;
  --ui-color-info: #6CAFCB;
  --ui-color-danger: #D98686;
  --ui-space-1: 4rpx;
  --ui-space-2: 8rpx;
  --ui-space-3: 12rpx;
  --ui-space-4: 16rpx;
  --ui-space-5: 20rpx;
  --ui-space-6: 24rpx;
  --ui-space-7: 28rpx;
  --ui-space-8: 32rpx;
  --ui-space-10: 40rpx;
  --ui-radius-sm: 14rpx;
  --ui-radius-md: 20rpx;
  --ui-radius-lg: 28rpx;
  --ui-radius-hero: 36rpx;
  --ui-radius-pill: 999rpx;
  --ui-shadow-soft: 0 8rpx 24rpx rgba(88, 96, 76, .08);
  --ui-shadow-hero: 0 14rpx 40rpx rgba(88, 96, 76, .10);
  --ui-shadow-float: 0 18rpx 48rpx rgba(70, 76, 64, .14);
  --ui-motion-fast: 160ms;
  --ui-motion-normal: 260ms;
  --ui-motion-grow: 520ms;
  --ui-motion-complete: 900ms;
  --ui-ease: cubic-bezier(.22, 1, .36, 1);
}
