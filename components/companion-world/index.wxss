:host {
  display: block;
}

.world-card {
  overflow: visible;
  border-radius: 36rpx;
  background: linear-gradient(180deg, #fffdf5 0%, #f4f8e9 100%);
  box-shadow: 0 18rpx 52rpx rgba(70, 91, 50, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
}

.world-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 30rpx 18rpx;
}

.world-title {
  color: #35402f;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.world-subtitle {
  margin-top: 7rpx;
  color: #7b856f;
  font-size: 22rpx;
}

.world-settings {
  min-width: 58rpx;
  height: 52rpx;
  border-radius: 26rpx;
  color: #6f7b66;
  font-size: 30rpx;
  line-height: 42rpx;
  text-align: center;
}

.world-settings-hover { background: rgba(255,255,255,.7); }

.world-scene {
  position: relative;
  height: 590rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #cfe8ed 0%, #eaf3d7 59%, #c8dca4 60%, #9fc17f 100%);
}

.garden-layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.garden-base {
  z-index: 1;
  border-radius: inherit;
}

.garden-foreground {
  z-index: 11;
  /* 只保留前景花草，裁掉素材右下角自带的第二块蓝色池面。 */
  clip-path: polygon(0 0, 100% 0, 100% 72%, 86% 72%, 86% 83%, 64% 83%, 64% 100%, 0 100%);
}

.garden-light {
  z-index: 12;
  opacity: .2;
  transition: opacity .9s ease;
}

.world-scene.is-complete .garden-light {
  opacity: .58;
}

.image-layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.background-image { z-index: 1; border-radius: inherit; }
.ground-image { z-index: 2; }
.path-image { z-index: 4; }
.water-image { z-index: 5; }
.plant-image { z-index: 6; }
.feedback-layer { z-index: 14; pointer-events: none; }
.sparkle-image { z-index: 15; }

.sky-glow {
  position: absolute;
  z-index: 1;
  top: -100rpx;
  left: 50%;
  width: 520rpx;
  height: 360rpx;
  border-radius: 50%;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(255,248,196,.72) 0%, rgba(255,248,196,0) 70%);
  opacity: .32;
  transition: opacity .8s ease;
}
.sky-glow.is-on { opacity: 1; }

.cloud {
  position: absolute;
  z-index: 2;
  width: 110rpx;
  height: 30rpx;
  border-radius: 40rpx;
  background: rgba(255,255,255,.55);
  filter: blur(1rpx);
}
.cloud::before, .cloud::after {
  content: '';
  position: absolute;
  bottom: 0;
  border-radius: 50%;
  background: inherit;
}
.cloud::before { left: 18rpx; width: 46rpx; height: 46rpx; }
.cloud::after { right: 15rpx; width: 56rpx; height: 56rpx; }
.cloud-a { top: 80rpx; left: 64rpx; }
.cloud-b { top: 138rpx; right: 58rpx; transform: scale(.72); opacity: .75; }

.hill {
  position: absolute;
  z-index: 2;
  border-radius: 50% 50% 0 0;
}
.hill-back { left: -80rpx; bottom: 142rpx; width: 520rpx; height: 190rpx; background: #b5ce9d; transform: rotate(4deg); }
.hill-front { right: -150rpx; bottom: 128rpx; width: 650rpx; height: 220rpx; background: #a2c28a; transform: rotate(-3deg); }
.ground { position: absolute; z-index: 3; left: -8%; bottom: -120rpx; width: 116%; height: 330rpx; border-radius: 50% 50% 0 0; background: linear-gradient(180deg,#a9c989,#85ad6c); }

.path-layer { position: absolute; z-index: 4; inset: 0; transform-origin: 50% 100%; }
.path-main, .path-extension, .path-far { position: absolute; border-radius: 50%; background: linear-gradient(90deg,rgba(255,246,204,0),rgba(255,246,204,.78),rgba(255,246,204,.12)); box-shadow: inset 0 2rpx 5rpx rgba(255,255,255,.5); transition: opacity .8s ease, filter .8s ease; }
.path-main { left: 43%; bottom: -5%; width: 22%; height: 47%; transform: rotate(-7deg); clip-path: polygon(43% 0, 58% 0, 100% 100%, 0 100%); opacity: .06; }
.path-extension { left: 54%; bottom: 38%; width: 22%; height: 7%; transform: rotate(-20deg); opacity: 0; }
.path-far { left: 69%; bottom: 49%; width: 15%; height: 5%; transform: rotate(-12deg); opacity: 0; }
.path-level-1 .path-main { opacity: .18; }
.path-level-2 .path-main { opacity: .28; filter: brightness(1.04); }
.path-level-2 .path-extension, .path-level-3 .path-extension, .path-level-4 .path-extension { opacity: .22; }
.path-level-3 .path-main { opacity: .38; filter: brightness(1.08); }
.path-level-4 .path-main { opacity: .5; filter: brightness(1.12); }
.path-level-3 .path-far, .path-level-4 .path-far { opacity: .22; }
.path-level-4 .path-extension, .path-level-4 .path-far { opacity: .36; }
.footprints { position: absolute; left: 50%; bottom: 31%; font-size: 34rpx; transform: rotate(-20deg); animation: footprintsMove 1.25s ease both; }

.water-layer { position: absolute; z-index: 5; right: 1.5%; bottom: 8.5%; width: 39%; height: 24%; overflow: hidden; border-radius: 50%; transition: transform .8s ease, opacity .8s ease; }
.pond-shadow { display: none; }
.pond { position: absolute; inset: 14% 5% 7%; overflow: hidden; border: 0; border-radius: 50%; background: linear-gradient(180deg,rgba(172,216,217,.62),rgba(102,174,190,.68)); transform: scale(.72); opacity: .2; transition: all .8s ease; }
.water-level-1 .pond { transform: scale(.78); opacity: .48; background: #9bbec4; }
.water-level-2 .pond { transform: scale(.88); opacity: .72; background: #80b9c5; }
.water-level-3 .pond { transform: scale(.96); opacity: .9; background: linear-gradient(180deg,#8ed1d5,#5dafbd); }
.water-level-4 .pond { transform: scale(1); opacity: .86; background: linear-gradient(180deg,rgba(167,226,221,.88),rgba(85,182,197,.9)); box-shadow: inset 0 5rpx 12rpx rgba(255,255,255,.22); }
.water-ripple { position: absolute; left: 50%; top: 50%; border: 3rpx solid rgba(255,255,255,.5); border-radius: 50%; transform: translate(-50%,-50%); opacity: 0; }
.water-level-2 .ripple-a, .water-level-3 .ripple-a, .water-level-4 .ripple-a { width: 90rpx; height: 30rpx; opacity: .55; }
.water-level-3 .ripple-b, .water-level-4 .ripple-b { width: 145rpx; height: 54rpx; opacity: .35; }
.water-reed { position: absolute; right: 2%; top: 7%; font-size: 42rpx; }
.water-lily { position: absolute; left: 22%; top: 36%; font-size: 32rpx; }
.water-drop { position: absolute; z-index: 3; left: 43%; top: -38%; font-size: 36rpx; animation: waterDrop .8s ease-in both; }

.plant-layer { position: absolute; z-index: 7; inset: 0; }
.plant-layer::before { content: ''; position: absolute; left: 35%; bottom: 5%; width: 36%; height: 43%; border-radius: 50%; background: radial-gradient(circle,rgba(181,232,126,.5),rgba(181,232,126,0) 68%); opacity: 0; pointer-events: none; }
.plant { position: absolute; transform-origin: 50% 100%; filter: drop-shadow(0 5rpx 5rpx rgba(55,85,35,.13)); }
.plant-a { left: 42%; bottom: 13%; font-size: 72rpx; }
.plant-b { left: 47%; bottom: 16%; font-size: 92rpx; }
.plant-c { left: 55%; bottom: 10%; font-size: 62rpx; }
.plant-d { left: 39%; bottom: 24%; font-size: 55rpx; }
.plant-e { left: 53%; bottom: 25%; font-size: 53rpx; }
.plant-tree { left: 43%; bottom: 19%; font-size: 132rpx; }
.plant-f { left: 57%; bottom: 15%; font-size: 61rpx; }

.world-decor { position: absolute; z-index: 7; pointer-events: none; }
.decor-flower { left: 57%; bottom: 8%; width: 40rpx; height: 40rpx; }
.decor-stone { right: 3%; bottom: 5%; width: 52rpx; height: 52rpx; }
.decor-grass { left: 3%; bottom: 4%; width: 66rpx; height: 66rpx; }

.world-discovery { position: absolute; filter: drop-shadow(0 5rpx 5rpx rgba(47,70,37,.18)); transition: transform .2s ease; }
.world-discovery-sky { z-index: 2; }
.world-discovery-ground { z-index: 8; }
.world-discovery-air { z-index: 10; }
.world-discovery-image { display: block; width: 100%; height: 100%; }
.world-discovery-hover { transform: scale(1.14); }
.discovery-near-plants { left: 45%; top: 27%; width: 58rpx; height: 58rpx; }
.discovery-near-plants .world-discovery-image { animation: butterflyFloat 3.2s ease-in-out infinite; }
.discovery-grass-edge { left: 5%; bottom: 8%; width: 72rpx; height: 72rpx; }
.discovery-far-path { right: 11%; top: 41%; width: 60rpx; height: 60rpx; }
.discovery-by-road { left: 57%; bottom: 18%; width: 104rpx; height: 104rpx; }
.discovery-night-air { right: 16%; top: 37%; width: 48rpx; height: 48rpx; }
.discovery-night-air .world-discovery-image { animation: fireflyGlow 2.4s ease-in-out infinite; }
.discovery-in-sky { left: 48%; top: 3%; width: 142rpx; height: 142rpx; transform: translateX(-50%); opacity: .78; }
.discovery-in-sky.world-discovery-hover { transform: translateX(-50%) scale(1.08); }

.journey-landmark { position: absolute; z-index: 16; right: 4%; top: 6%; display: flex; min-height: 70rpx; box-sizing: border-box; align-items: center; gap: 9rpx; max-width: 218rpx; padding: 10rpx 16rpx 10rpx 11rpx; border: 1rpx solid rgba(127,163,106,.24); border-radius: 30rpx; background: rgba(255,252,245,.9); box-shadow: 0 8rpx 22rpx rgba(73,102,78,.12); }
.journey-landmark-hover { transform: scale(.97); }
.landmark-emoji { font-size: 38rpx; }
.landmark-copy { display: flex; flex-direction: column; min-width: 0; }
.landmark-title { color: #3f4b38; font-size: 21rpx; font-weight: 700; white-space: nowrap; }
.landmark-hint { color: #768169; font-size: 18rpx; }

.companion-home { position: absolute; z-index: 9; left: 30%; bottom: 9%; display: flex; flex-direction: column; align-items: center; transform: translateX(-50%); transition: transform .25s ease; }
.companion-home-hover { transform: translateX(-50%) scale(1.05); }
.companion-shadow { position: absolute; bottom: 37rpx; width: 164rpx; height: 34rpx; border-radius: 50%; background: rgba(53,76,42,.18); filter: blur(5rpx); }
.companion-image { position: relative; width: 286rpx; height: 306rpx; }
.companion-placeholder { position: relative; display: flex; width: 202rpx; height: 246rpx; align-items: center; justify-content: flex-end; flex-direction: column; filter: drop-shadow(0 9rpx 7rpx rgba(63,85,46,.16)); }
.companion-leaf { position: absolute; z-index: 2; top: -8rpx; font-size: 60rpx; transform: rotate(-8deg); }
.companion-body { position: relative; display: flex; width: 105rpx; height: 112rpx; align-items: center; justify-content: center; border: 5rpx solid rgba(108,142,78,.32); border-radius: 55% 55% 48% 48%; background: linear-gradient(155deg,#fffced,#dcebbf); box-shadow: inset -8rpx -9rpx 15rpx rgba(111,143,80,.12); }
.companion-face { margin-top: 15rpx; color: #4f6545; font-size: 22rpx; font-weight: 700; white-space: nowrap; }
.stage-seed .companion-placeholder { transform: scale(.88); }
.stage-growing .companion-placeholder { transform: scale(1.06); }
.stage-grown .companion-placeholder { transform: scale(1.14); }
.companion-name { position: relative; margin-top: 2rpx; padding: 3rpx 14rpx; border-radius: 20rpx; color: #4f5c46; font-size: 19rpx; background: rgba(255,255,255,.7); }

.complete-effects { position: absolute; z-index: 14; inset: 0; pointer-events: none; }
.sun { position: absolute; left: 55rpx; top: 22rpx; font-size: 76rpx; filter: drop-shadow(0 0 20rpx rgba(255,223,92,.65)); }
.flower { position: absolute; font-size: 43rpx; }
.flower-a { left: 29rpx; bottom: 63rpx; }
.flower-b { right: 248rpx; bottom: 54rpx; }
.sparkles { position: absolute; z-index: 15; inset: 0; pointer-events: none; }
.sparkle { position: absolute; opacity: 0; animation: sparkleRise 1.5s ease both; }
.sparkle-a { left: 25%; top: 27%; font-size: 48rpx; }
.sparkle-b { right: 18%; top: 36%; font-size: 40rpx; animation-delay: .15s; }
.sparkle-c { left: 46%; top: 12%; font-size: 35rpx; animation-delay: .3s; }
.sparkle-d { right: 42%; bottom: 25%; font-size: 42rpx; animation-delay: .45s; }

.world-message { min-height: 70rpx; padding: 22rpx 34rpx 10rpx; color: #495443; font-size: 27rpx; font-weight: 600; line-height: 1.55; text-align: center; white-space: pre-line; transition: color .25s ease; }
.world-message.is-live { color: #6c844e; }

.world-status-row { display: flex; justify-content: center; gap: 10rpx; padding: 10rpx 24rpx 16rpx; }
.status-pill { display: flex; align-items: center; gap: 5rpx; padding: 8rpx 12rpx; border-radius: 20rpx; color: #8a9181; font-size: 19rpx; background: rgba(255,255,255,.63); }
.status-pill.is-done { color: #567341; background: #edf5df; }

.next-unlock { display: flex; align-items: center; gap: 16rpx; margin: 0 26rpx 18rpx; padding: 16rpx 20rpx; border-radius: 22rpx; background: rgba(255,255,255,.7); }
.next-unlock-hover { background: rgba(255,255,255,.95); }
.next-unlock-preview { display: flex; flex: 0 0 58rpx; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border-radius: 50%; color: rgba(76,96,62,.34); font-size: 38rpx; background: rgba(113,139,91,.12); border: 2rpx dashed rgba(91,116,72,.24); }
.next-unlock-copy { flex: 1; min-width: 0; }
.next-unlock-label { display: block; color: #a17c4c; font-size: 19rpx; font-weight: 700; }
.next-unlock-text { display: block; margin-top: 4rpx; color: #66705d; font-size: 22rpx; line-height: 1.45; }
.next-unlock-description { display: block; margin-top: 2rpx; color: #9aa18f; font-size: 18rpx; }

.world-footer { display: flex; align-items: center; justify-content: space-between; padding: 0 30rpx 26rpx; }
.energy-text { color: #8d846c; font-size: 20rpx; }
.journey-link { color: #617750; font-size: 22rpx; font-weight: 600; }
.world-footer-links { display: flex; align-items: center; gap: 20rpx; }
.discovery-link { color: #8a7252; font-size: 22rpx; font-weight: 600; }
.journey-link-hover { opacity: .65; }

.transition-plant .plant-layer, .transition-plant-level .plant-layer { animation: plantGrow .9s cubic-bezier(.2,.8,.2,1) both; }
.transition-plant .plant-layer::before { animation: plantGlow 1.25s ease both; }
.transition-path .path-layer, .transition-path-level .path-layer { animation: pathGrow .95s ease both; }
.transition-water .pond, .transition-water-level .pond { animation: waterFill 1.05s ease both; }
.transition-water .water-ripple, .transition-water-level .water-ripple { animation: ripplePulse 1.25s ease .3s both; }
.transition-all .garden-light { animation: gardenLightCelebrate 1.6s ease both; }
.transition-all .companion-home { animation: companionCelebrate 1s ease 2; }
.transition-plant .companion-home, .transition-path .companion-home, .transition-water .companion-home { animation: companionHappy .85s ease both; }

@keyframes plantGrow { 0% { transform: scale(.82); opacity: .38; } 65% { transform: scale(1.06); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
@keyframes plantGlow { 0% { opacity: 0; transform: scale(.72); } 40% { opacity: 1; } 100% { opacity: 0; transform: scale(1.18); } }
@keyframes pathGrow { 0% { transform: scaleX(.42); opacity: .25; } 100% { transform: scaleX(1); opacity: 1; } }
@keyframes waterFill { 0% { transform: scale(.72); opacity: .35; } 70% { transform: scale(1.05); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
@keyframes waterDrop { 0% { transform: translateY(-34rpx) scale(.7); opacity: 0; } 35% { opacity: 1; } 100% { transform: translateY(75rpx) scale(1); opacity: 0; } }
@keyframes ripplePulse { 0% { transform: translate(-50%,-50%) scale(.5); opacity: 0; } 45% { opacity: .75; } 100% { transform: translate(-50%,-50%) scale(1.28); opacity: 0; } }
@keyframes footprintsMove { 0% { transform: translate(-28rpx,42rpx) rotate(-20deg); opacity: 0; } 35% { opacity: 1; } 100% { transform: translate(28rpx,-28rpx) rotate(-20deg); opacity: 0; } }
@keyframes companionHappy { 0% { transform: translateX(-50%) scale(.9); } 55% { transform: translateX(-50%) translateY(-18rpx) scale(1.06); } 100% { transform: translateX(-50%) scale(1); } }
@keyframes companionCelebrate { 0%,100% { transform: translateX(-50%) translateY(0) rotate(0); } 35% { transform: translateX(-50%) translateY(-22rpx) rotate(-4deg); } 70% { transform: translateX(-50%) translateY(-8rpx) rotate(4deg); } }
@keyframes sparkleRise { 0% { opacity: 0; transform: translateY(24rpx) scale(.5); } 35% { opacity: 1; } 100% { opacity: 0; transform: translateY(-42rpx) scale(1.2); } }
@keyframes butterflyFloat { 0%,100% { transform: translate(0,0) rotate(-5deg); } 50% { transform: translate(12rpx,-13rpx) rotate(8deg); } }
@keyframes fireflyGlow { 0%,100% { opacity: .45; transform: scale(.85); } 50% { opacity: 1; transform: scale(1.15); } }
@keyframes gardenLightCelebrate { 0% { opacity: .18; } 45% { opacity: 1; } 100% { opacity: .78; } }

@media (max-width: 390px) {
  .world-scene { height: 580rpx; }
  .garden-light { opacity: .18; }
  .journey-landmark { right: 3%; max-width: 204rpx; }
  .companion-image { width: 268rpx; height: 288rpx; }
}
