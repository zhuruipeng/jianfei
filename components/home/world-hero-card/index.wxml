<view class="hero-card">
  <view class="hero-header">
    <view class="journey-copy">
      <text class="journey-title">{{journeyTitle}}</text>
      <text wx:if="{{journeyDayText}}" class="journey-day">{{journeyDayText}}</text>
      <view class="journey-meta">
        <text wx:if="{{dateText}}">{{dateText}}</text>
        <text wx:if="{{dateText && atmosphereText}}" class="meta-divider">·</text>
        <text wx:if="{{atmosphereText}}">{{atmosphereText}}</text>
      </view>
    </view>
    <view class="hero-header-actions">
      <view wx:if="{{settingsVisible}}" class="settings-entry" aria-role="button" aria-label="计划设置" bindtap="onSettingsTap" hover-class="header-entry-active">···</view>
      <view class="discovery-count" aria-role="button" aria-label="已发现 {{discoveryCount}} 个世界发现，查看我的发现" bindtap="onDiscoveriesEntryTap" hover-class="header-entry-active">
        <text class="discovery-mark">✦</text>
        <text>发现 {{discoveryCount}}</text>
      </view>
    </view>
  </view>

  <view class="scene-shell">
    <companion-world
      state="{{worldState}}"
      assets="{{worldAssets}}"
      transition="{{worldTransition}}"
      companion-stage="{{companionStage}}"
      companion-mood="{{companionMood}}"
      companion-asset="{{companionAsset}}"
      companion-name="{{companionName}}"
      message=""
      header-text=""
      subtitle-text=""
      energy-text=""
      settings-visible="{{false}}"
      discoveries="{{discoveries}}"
      discovery-count="{{discoveryCount}}"
      bind:companiontap="onCompanionTap"
      bind:journeytap="onJourneyTap"
      bind:discoverytap="onDiscoveryTap"
    />
  </view>

  <view class="status-row">
    <ui-status-pill
      class="status-pill"
      icon="🌱"
      label="植物"
      value="{{plantText}}"
      tone="green"
      active="{{worldState.todayMealCompleted}}"
    />
    <ui-status-pill
      class="status-pill"
      icon="🛤️"
      label="小路"
      value="{{pathText}}"
      tone="wood"
      active="{{worldState.todayExerciseCompleted}}"
    />
    <ui-status-pill
      class="status-pill"
      icon="💧"
      label="水池"
      value="{{waterText}}"
      tone="water"
      active="{{worldState.todayWaterCompleted}}"
    />
  </view>

  <view class="companion-panel">
    <view class="companion-copy">
      <text class="companion-name">{{companionName}}</text>
      <text class="companion-message">{{companionMessage}}</text>
    </view>
    <view class="energy-badge" aria-label="轻能量 {{energyValue}} / {{energyMax}}">
      <view class="energy-badge__leaf"></view>
      <view class="energy-badge__core">
        <view class="energy-badge__value-row">
          <text class="energy-number">{{energyValue}}</text>
          <text class="energy-unit"> / {{energyMax}}</text>
        </view>
        <text class="energy-label">轻能量</text>
      </view>
    </view>
  </view>

  <view wx:if="{{nextUnlockVisible}}" class="next-unlock-wrap">
    <ui-paper-note
      title="下一次变化"
      description="{{nextUnlockTitle}}"
      image-src="{{nextUnlockImage}}"
      action-text="去看看"
      compact="{{true}}"
      bind:action="onNextUnlockTap"
    />
  </view>

  <view class="hero-footer">
    <text class="world-footnote">小世界会跟着你的每一步生长</text>
    <view
      class="journey-entry {{journeyEntryEnabled ? '' : 'is-disabled'}}"
      aria-role="button"
      aria-label="{{journeyEntryTitle}}"
      bindtap="onJourneyTap"
      hover-class="journey-entry-active"
    >
      <text>{{journeyEntryTitle}}</text>
      <text class="journey-arrow">›</text>
    </view>
  </view>
</view>
