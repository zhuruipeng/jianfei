<view class="hero ui-theme">
  <view class="head"><view class="journey"><text class="title">{{journeyTitle}}</text><text wx:if="{{journeyDayText}}" class="day">{{journeyDayText}}</text><view class="meta"><text>{{dateText}}</text><text wx:if="{{atmosphereText}}">· {{atmosphereText}}</text></view></view><view wx:if="{{settingsVisible}}" class="settings" bindtap="onSettingsTap" hover-class="pressed">•••</view></view>
  <view class="scene"><companion-world embedded="{{true}}" state="{{worldState}}" assets="{{worldAssets}}" transition="{{worldTransition}}" companion-stage="{{companionStage}}" companion-mood="{{companionMood}}" companion-asset="{{companionAsset}}" companion-name="{{companionName}}" message="{{companionMessage}}" discoveries="{{discoveries}}" discovery-count="{{discoveryCount}}" bind:companiontap="onCompanionTap" bind:journeytap="onJourneyTap" bind:discoverytap="onDiscoveryTap"></companion-world></view>
  <view class="status"><view class="status-item"><ui-status-pill icon="🌱" label="植物" value="{{plantText}}" tone="green" active="{{worldState.todayMealCompleted}}"></ui-status-pill></view><view class="status-item"><ui-status-pill icon="⌁" label="小路" value="{{pathText}}" tone="wood" active="{{worldState.todayExerciseCompleted}}"></ui-status-pill></view><view class="status-item"><ui-status-pill icon="◌" label="水池" value="{{waterText}}" tone="water" active="{{worldState.todayWaterCompleted}}"></ui-status-pill></view></view>
  <view class="message-row"><view class="message-copy"><text class="message">{{companionMessage}}</text><text class="note">慢慢来，你已经做得很好了。</text></view><view class="energy"><text class="energy-value">{{energyValue}}<text class="energy-max"> / {{energyMax}}</text></text><text class="energy-label">轻能量</text></view></view>
  <ui-paper-note wx:if="{{nextUnlockVisible}}" eyebrow="明天的期待" title="{{nextUnlockTitle}}" description="{{nextUnlockDescription}}" image-src="{{nextUnlockImage}}" bind:action="onNextUnlockTap"></ui-paper-note>
  <view class="footer"><view class="link" bindtap="onDiscoveriesTap" hover-class="link-pressed">发现 {{discoveryCount}} / 6</view><view class="link journey-link {{journeyEntryEnabled?'':'disabled'}}" bindtap="onJourneyTap" hover-class="link-pressed">{{journeyEntryTitle}} <text class="journey-arrow">›</text></view></view>
</view>
