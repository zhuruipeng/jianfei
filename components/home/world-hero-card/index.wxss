:host {
  display: block;
  min-width: 0;
}

.hero-card {
  position: relative;
  overflow: visible;
  box-sizing: border-box;
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, .92);
  border-radius: var(--ui-radius-hero);
  background: linear-gradient(180deg, rgba(255, 253, 247, .98), rgba(249, 248, 237, .98));
  box-shadow: var(--ui-shadow-hero);
}

.hero-card::before {
  content: '';
  position: absolute;
  z-index: 0;
  top: 20rpx;
  right: 30rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(241, 206, 112, .15), rgba(241, 206, 112, 0) 70%);
  pointer-events: none;
}

.hero-header,
.scene-shell,
.status-row,
.companion-panel,
.energy-progress,
.next-unlock-wrap,
.hero-footer {
  position: relative;
  z-index: 1;
}

.hero-header {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 2rpx 4rpx 22rpx;
}

.journey-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.journey-title {
  overflow: hidden;
  color: var(--ui-color-text);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.journey-day {
  margin-top: 2rpx;
  color: var(--ui-color-green-deep);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.journey-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 6rpx;
  color: var(--ui-color-text-secondary);
  font-size: 20rpx;
  line-height: 30rpx;
}

.meta-divider {
  color: var(--ui-color-border);
}

.hero-header-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
}

.settings-entry {
  display: flex;
  width: 54rpx;
  min-height: 54rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(127, 163, 106, .18);
  border-radius: var(--ui-radius-pill);
  color: var(--ui-color-green-deep);
  font-size: 27rpx;
  background: rgba(231, 240, 219, .72);
}

.discovery-count {
  display: flex;
  flex: 0 0 auto;
  min-height: 54rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 7rpx;
  padding: 0 17rpx;
  border: 1rpx solid rgba(158, 116, 75, .16);
  border-radius: var(--ui-radius-pill);
  color: var(--ui-color-wood);
  font-size: 20rpx;
  font-weight: 600;
  background: rgba(255, 248, 232, .8);
}

.discovery-mark {
  color: var(--ui-color-sun);
  font-size: 24rpx;
}

.header-entry-active {
  opacity: .62;
}

.scene-shell {
  overflow: visible;
  border-radius: var(--ui-radius-lg);
  background: linear-gradient(180deg, #D9EEF0, #EAF2DA 62%, #B6D297);
}

.status-row {
  display: flex;
  min-width: 0;
  justify-content: center;
  gap: 8rpx;
  margin: -34rpx 8rpx 0;
}

.status-pill {
  min-width: 0;
  flex: 1;
}

.companion-panel {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 10rpx 18rpx;
}

.companion-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.companion-name {
  color: var(--ui-color-wood);
  font-size: 19rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.companion-message {
  margin-top: 3rpx;
  color: var(--ui-color-text);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 38rpx;
  white-space: pre-line;
}

.energy-badge {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  width: 124rpx;
  height: 124rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #D9BE96;
  border-radius: 50%;
  color: var(--ui-color-wood);
  background: linear-gradient(145deg, #FFFDF7, #FFF5DE);
  box-shadow:
    inset 0 0 0 3rpx rgba(158, 116, 75, .16),
    0 7rpx 18rpx rgba(128, 95, 57, .14);
}

.energy-badge__leaf {
  position: absolute;
  top: 5rpx;
  right: -7rpx;
  width: 24rpx;
  height: 13rpx;
  border-radius: 80% 15% 80% 15%;
  background: linear-gradient(145deg, #A8C98F, #7FA36A);
  box-shadow: 0 2rpx 5rpx rgba(73, 102, 78, .16);
  transform: rotate(-28deg);
}

.energy-badge__core {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.energy-badge__value-row {
  display: flex;
  align-items: baseline;
}

.energy-number {
  font-size: 25rpx;
  font-weight: 700;
}

.energy-unit {
  color: var(--ui-color-text-secondary);
  font-size: 16rpx;
}

.energy-label {
  margin-top: 3rpx;
  color: var(--ui-color-text-secondary);
  font-size: 17rpx;
  line-height: 24rpx;
}

.energy-progress {
  margin: 0 10rpx;
  padding: 17rpx 20rpx 20rpx;
  border-radius: var(--ui-radius-md);
  background: rgba(247, 240, 218, .62);
}

.energy-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 11rpx;
  color: var(--ui-color-text-secondary);
  font-size: 18rpx;
  line-height: 28rpx;
}

.energy-caption__label {
  color: var(--ui-color-wood);
  font-weight: 600;
}

.next-unlock-wrap {
  margin-top: 22rpx;
}

.hero-footer {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 4rpx 0;
}

.world-footnote {
  min-width: 0;
  color: var(--ui-color-text-weak);
  font-size: 18rpx;
  line-height: 28rpx;
}

.journey-entry {
  display: flex;
  flex: 0 0 auto;
  min-height: 56rpx;
  align-items: center;
  gap: 6rpx;
  color: var(--ui-color-green-deep);
  font-size: 21rpx;
  font-weight: 700;
  transition: opacity var(--ui-motion-fast) var(--ui-ease), transform var(--ui-motion-fast) var(--ui-ease);
}

.journey-arrow {
  margin-top: -2rpx;
  font-size: 31rpx;
  font-weight: 400;
}

.journey-entry-active {
  opacity: .58;
  transform: translateX(3rpx);
}

.journey-entry.is-disabled {
  opacity: .4;
}

@media (max-width: 390px) {
  .hero-card {
    padding: 20rpx;
  }

  .status-row {
    gap: 5rpx;
    margin-right: 0;
    margin-left: 0;
  }

  .companion-panel {
    padding-right: 4rpx;
    padding-left: 4rpx;
  }

  .energy-badge {
    width: 112rpx;
    height: 112rpx;
    border-width: 7rpx;
  }

  .world-footnote {
    display: none;
  }

  .hero-footer {
    justify-content: flex-end;
  }
}
