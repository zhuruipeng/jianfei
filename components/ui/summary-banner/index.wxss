@import "../../../styles/ui-tokens.wxss";
:host{display:block}.banner{display:flex;min-height:126rpx;box-sizing:border-box;align-items:center;gap:14rpx;padding:19rpx;border:1rpx solid rgba(127,163,106,.14);border-radius:24rpx;background:var(--ui-color-surface-soft);box-shadow:var(--ui-shadow-soft);transition:transform var(--ui-motion-fast) var(--ui-ease),opacity var(--ui-motion-fast)}.pressed{transform:scale(.985);opacity:.93}.tone-blue{background:#EDF5F7}.tone-warm{background:#FAF1DF}.visual{display:flex;flex:0 0 62rpx;width:62rpx;height:62rpx;align-items:center;justify-content:center;border-radius:19rpx;background:rgba(255,255,255,.58)}.image{width:55rpx;height:55rpx}.emoji{font-size:36rpx}.copy{display:flex;min-width:0;flex:1;flex-direction:column}.title{overflow:hidden;color:var(--ui-color-text);font-size:24rpx;font-weight:600;line-height:35rpx;text-overflow:ellipsis;white-space:nowrap}.subtitle{display:-webkit-box;overflow:hidden;color:var(--ui-color-text-secondary);font-size:18rpx;line-height:27rpx;-webkit-box-orient:vertical;-webkit-line-clamp:2}.action{display:flex;align-items:center;color:var(--ui-color-green-deep);font-size:18rpx;white-space:nowrap}.arrow{font-size:31rpx}.compact{min-height:112rpx;padding:16rpx}@media(max-width:390px){.banner{padding:14rpx;gap:10rpx}.visual{flex-basis:52rpx;width:52rpx;height:52rpx}.title{font-size:22rpx}.subtitle{font-size:17rpx}}
