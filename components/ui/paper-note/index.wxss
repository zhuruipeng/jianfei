:host {
  display: block;
  min-width: 0;
}

.paper-note {
  position: relative;
  display: flex;
  min-height: 150rpx;
  box-sizing: border-box;
  align-items: center;
  gap: var(--ui-space-6);
  padding: var(--ui-space-6) var(--ui-space-7) var(--ui-space-6) var(--ui-space-9);
  border: 1rpx solid rgba(217, 190, 150, .22);
  border-radius: var(--ui-radius-md);
  background: linear-gradient(155deg, rgba(255, 253, 247, .98), rgba(250, 244, 230, .94));
  box-shadow: 0 7rpx 20rpx rgba(128, 103, 72, .055);
}

.paper-note__clip {
  position: absolute;
  top: -12rpx;
  left: 18rpx;
  width: 20rpx;
  height: 52rpx;
  box-sizing: border-box;
  border: 4rpx solid rgba(154, 138, 115, .55);
  border-bottom-color: transparent;
  border-radius: var(--ui-radius-sm);
  transform: rotate(-8deg);
}

.paper-note__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.paper-note__eyebrow {
  color: var(--ui-color-wood);
  font-size: 19rpx;
  font-weight: 600;
  line-height: 28rpx;
}

.paper-note__title {
  margin-top: 0;
  color: #765832;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 38rpx;
}

.paper-note__description {
  margin-top: var(--ui-space-2);
  color: var(--ui-color-text-secondary);
  font-size: 21rpx;
  line-height: 32rpx;
}

.paper-note__action {
  display: flex;
  min-height: 88rpx;
  align-self: flex-start;
  align-items: center;
  gap: var(--ui-space-1);
  margin-top: var(--ui-space-1);
  color: var(--ui-color-wood);
  font-size: 21rpx;
  font-weight: 600;
  transition: transform var(--ui-motion-fast) var(--ui-ease), opacity var(--ui-motion-fast) ease;
}

.paper-note__action--pressed {
  transform: translateX(4rpx);
  opacity: .72;
}

.paper-note__arrow {
  font-size: 32rpx;
  line-height: 1;
}

.paper-note__image {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
}

.paper-note__leaf {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-pill);
  color: var(--ui-color-green);
  font-size: 44rpx;
  background: rgba(127, 163, 106, .12);
}

.paper-note--compact {
  min-height: 136rpx;
  padding-top: var(--ui-space-5);
  padding-bottom: var(--ui-space-5);
}
