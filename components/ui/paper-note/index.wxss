@import "../../../styles/ui-tokens.wxss";
:host{display:block}.note{position:relative;display:flex;min-height:150rpx;box-sizing:border-box;align-items:center;gap:18rpx;padding:24rpx 24rpx 22rpx 42rpx;border:1rpx solid rgba(217,190,150,.48);border-radius:20rpx;background:linear-gradient(155deg,#FFFCF4,#F7EEDC);box-shadow:0 7rpx 20rpx rgba(128,103,72,.08);transition:transform var(--ui-motion-fast) var(--ui-ease)}.pressed{transform:scale(.988)}.clip{position:absolute;left:18rpx;top:-12rpx;width:20rpx;height:52rpx;border:5rpx solid #9A8A73;border-bottom-color:transparent;border-radius:15rpx;transform:rotate(-8deg)}.copy{display:flex;min-width:0;flex:1;flex-direction:column}.eyebrow{color:var(--ui-color-wood);font-size:18rpx;font-weight:600;line-height:26rpx}.title{margin-top:3rpx;color:#765832;font-size:25rpx;font-weight:600;line-height:36rpx}.description{margin-top:5rpx;color:var(--ui-color-text-secondary);font-size:21rpx;line-height:32rpx}.action{margin-top:8rpx;color:var(--ui-color-wood);font-size:19rpx}.image{flex:0 0 88rpx;width:88rpx;height:88rpx}.plant{display:flex;flex:0 0 72rpx;width:72rpx;height:72rpx;align-items:center;justify-content:center;border-radius:50%;color:var(--ui-color-green);font-size:44rpx;background:rgba(127,163,106,.12)}.compact{min-height:124rpx;padding-top:18rpx;padding-bottom:18rpx}
