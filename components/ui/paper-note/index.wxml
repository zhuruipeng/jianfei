<view class="note {{compact?'compact':''}}" bindtap="onAction" hover-class="pressed"><view class="clip"></view><view class="copy"><text wx:if="{{eyebrow}}" class="eyebrow">{{eyebrow}}</text><text class="title">{{title}}</text><text wx:if="{{description}}" class="description">{{description}}</text><view wx:if="{{actionText}}" class="action">{{actionText}} ›</view></view><image wx:if="{{imageSrc}}" class="image" src="{{imageSrc}}" mode="aspectFit"></image><view wx:else class="plant"><text>♧</text></view></view>
