@import "../../../styles/ui-tokens.wxss";
:host{display:inline-flex}.button{display:inline-flex;min-width:128rpx;height:80rpx;box-sizing:border-box;align-items:center;justify-content:center;gap:10rpx;padding:0 28rpx;border-radius:var(--ui-radius-pill);font-size:24rpx;font-weight:600;transition:transform var(--ui-motion-fast) var(--ui-ease),opacity var(--ui-motion-fast)}.variant-primary{color:#FFFCF5;background:var(--ui-color-green-deep)}.variant-secondary{color:var(--ui-color-green-deep);background:var(--ui-color-green-soft)}.variant-ghost{color:var(--ui-color-green-deep);background:transparent}.variant-danger{color:#fff;background:var(--ui-color-danger)}.size-sm{height:64rpx;padding:0 22rpx;font-size:22rpx}.size-lg{height:88rpx}.full{width:100%}.disabled{opacity:.45}.pressed{transform:scale(.975);opacity:.9}.spinner{width:24rpx;height:24rpx;border:3rpx solid rgba(255,255,255,.42);border-top-color:currentColor;border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
