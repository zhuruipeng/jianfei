<view
  class="button variant-{{variant}} size-{{size}} {{fullWidth ? 'is-full' : ''}} {{disabled || loading ? 'is-disabled' : ''}}"
  bindtap="onTap"
  hover-class="{{disabled || loading ? '' : 'button-active'}}"
>
  <view wx:if="{{loading}}" class="spinner"></view>
  <text class="button-text">{{loading ? '请稍候' : text}}</text>
</view>
