@import "../../../styles/ui-tokens.wxss";
:host{display:block;min-width:0}.task{display:flex;min-height:184rpx;box-sizing:border-box;flex-direction:column;padding:18rpx;border:1rpx solid var(--ui-color-border);border-radius:24rpx;background:var(--ui-color-surface);box-shadow:var(--ui-shadow-soft);transition:transform var(--ui-motion-fast) var(--ui-ease),opacity var(--ui-motion-fast)}.pressed{transform:scale(.975);opacity:.93}.head{display:flex;align-items:center;gap:10rpx}.icon-shell{display:flex;flex:0 0 52rpx;width:52rpx;height:52rpx;align-items:center;justify-content:center;border-radius:17rpx;background:rgba(217,190,150,.16)}.icon-image{width:44rpx;height:44rpx}.icon-emoji{font-size:30rpx}.copy{display:flex;min-width:0;flex:1;flex-direction:column}.title{overflow:hidden;color:var(--ui-color-text);font-size:23rpx;font-weight:600;line-height:34rpx;text-overflow:ellipsis;white-space:nowrap}.subtitle{overflow:hidden;color:var(--ui-color-text-secondary);font-size:17rpx;line-height:26rpx;text-overflow:ellipsis;white-space:nowrap}.indicator{margin-top:auto;padding-top:14rpx}.check,.ring-row{display:flex;align-items:center;gap:8rpx}.mark{display:flex;width:36rpx;height:36rpx;align-items:center;justify-content:center;border:2rpx solid var(--ui-color-border);border-radius:50%;color:var(--ui-color-text-weak);font-size:23rpx}.indicator-text{color:var(--ui-color-text-secondary);font-size:17rpx;line-height:27rpx}.ring{display:flex;width:40rpx;height:40rpx;align-items:center;justify-content:center;border:6rpx solid rgba(228,162,57,.24);border-top-color:var(--ui-color-progress);border-radius:50%;color:var(--ui-color-progress);font-size:14rpx;font-weight:600}.bar-row{display:flex;flex-direction:column;gap:7rpx}.footer{margin-top:6rpx;color:var(--ui-color-text-weak);font-size:16rpx}.status-completed{border-color:rgba(114,164,95,.22);background:linear-gradient(145deg,#F4F8EC,#EEF5E4)}.status-completed .mark{border-color:var(--ui-color-success);color:#fff;background:var(--ui-color-success)}.status-active.tone-yellow{background:#FFF8E7}.status-active.tone-blue{background:#EFF8FA}.disabled{opacity:.5}
@media(max-width:390px){.task{padding:15rpx}.icon-shell{flex-basis:46rpx;width:46rpx;height:46rpx}.title{font-size:22rpx}.subtitle{font-size:16rpx}}
