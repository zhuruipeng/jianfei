@import "../../../styles/ui-tokens.wxss";
:host{position:fixed;z-index:120;left:50%;bottom:180rpx;transform:translateX(-50%);pointer-events:none}.toast{display:flex;min-width:260rpx;max-width:590rpx;box-sizing:border-box;align-items:center;justify-content:center;gap:12rpx;padding:18rpx 24rpx;border:1rpx solid rgba(127,163,106,.22);border-radius:var(--ui-radius-pill);color:var(--ui-color-green-deep);background:rgba(255,252,245,.96);box-shadow:var(--ui-shadow-float);animation:toastIn var(--ui-motion-normal) var(--ui-ease) both}.tone-water{color:#477D91}.tone-warm{color:#8B642B}.icon{font-size:28rpx}.text{font-size:23rpx;font-weight:600;white-space:nowrap}@keyframes toastIn{from{transform:translateY(18rpx);opacity:0}to{transform:translateY(0);opacity:1}}
