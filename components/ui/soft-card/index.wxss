@import "../../../styles/ui-tokens.wxss";
:host{display:block}.card{box-sizing:border-box;border:1rpx solid var(--ui-color-border);border-radius:var(--ui-radius-lg);background:var(--ui-color-surface);box-shadow:var(--ui-shadow-soft);transition:transform var(--ui-motion-fast) var(--ui-ease)}.padding-sm{padding:18rpx}.padding-md{padding:24rpx}.padding-lg{padding:32rpx}.padding-none{padding:0}.compact{border-radius:24rpx}.variant-green{background:var(--ui-color-surface-soft)}.variant-blue{background:#EDF6F7}.variant-yellow{background:#FBF3DD}.variant-paper{border-color:rgba(217,190,150,.45);background:linear-gradient(155deg,#FFFDF7,#F8F0DF)}.disabled{opacity:.48}.active{transform:scale(.985)}
