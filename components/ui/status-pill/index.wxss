:host {
  display: inline-flex;
  min-width: 0;
}

.pill {
  display: flex;
  min-width: 0;
  height: 58rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.64);
  border-radius: var(--ui-radius-pill);
  color: var(--ui-color-text-secondary);
  background: rgba(255, 252, 245, 0.68);
  box-shadow: 0 3rpx 10rpx rgba(80, 92, 74, 0.05);
  white-space: nowrap;
  transition: color var(--ui-motion-normal) ease,
    border-color var(--ui-motion-normal) ease,
    background-color var(--ui-motion-normal) ease;
}

.icon {
  flex: none;
  font-size: 24rpx;
  line-height: 1;
}

.label,
.value {
  overflow: hidden;
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
}

.value {
  flex: none;
  font-weight: var(--ui-font-weight-semibold);
}

.tone-green.is-active {
  border-color: rgba(127, 163, 106, 0.26);
  color: var(--ui-color-green-deep);
  background: rgba(240, 246, 232, .78);
}

.tone-wood.is-active {
  border-color: rgba(217, 190, 150, 0.34);
  color: var(--ui-color-wood-deep);
  background: rgba(252, 244, 228, .78);
}

.tone-water.is-active {
  border-color: rgba(108, 175, 203, 0.26);
  color: #477d91;
  background: rgba(237, 247, 249, .78);
}

.tone-neutral.is-active {
  border-color: var(--ui-color-border);
  color: var(--ui-color-text);
  background: var(--ui-color-card);
}
