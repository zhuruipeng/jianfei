@import "../../../styles/ui-tokens.wxss";
:host{display:inline-flex;min-width:0}.pill{display:flex;min-width:0;height:66rpx;align-items:center;justify-content:center;gap:6rpx;padding:0 16rpx;border:1rpx solid rgba(255,255,255,.85);border-radius:var(--ui-radius-pill);color:var(--ui-color-text-secondary);font-size:21rpx;background:rgba(255,252,245,.86);box-shadow:0 4rpx 14rpx rgba(80,92,74,.07);white-space:nowrap}.icon{font-size:27rpx}.value{font-weight:600}.tone-green.active{color:var(--ui-color-green-deep);background:#F0F6E8}.tone-wood.active{color:var(--ui-color-wood);background:#FCF4E4}.tone-water.active{color:#477D91;background:#EDF7F9}
